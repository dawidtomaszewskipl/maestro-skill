#!/usr/bin/env bash
# maestro-identity — the effective-identity check after every external launch and resume
# (docs/commands.md, "Effective identity"). Read-only; prints one JSON line, exit 0 iff result OK.
#
#   maestro-identity codex --thread T --role R [--rung 1|3|4] --model M --effort E
#                          [--offset N] [--root DIR] [--wait S]
#       The first turn_context after line N (0 for a launch; the rollout's line count recorded
#       before a resume) of the thread's rollout ($CODEX_HOME/sessions/…/rollout-*-T.jsonl) must
#       show model, effort, sandbox, approvals and the permission profile of the role:
#         critic|gate|reviewer|probe|arbiter  read-only, never, user, restricted, no write roots
#         builder|drafter|fix rung 1  workspace-write, never, user, restricted, ROOT only
#         rung 3                      workspace-write, on-request, auto_review, restricted, ROOT only
#         rung 4                      danger-full-access, never, user (profile disabled: not checked)
#       /tmp and $TMPDIR are allowed writable specials; any other is a mismatch. cyber_access_program
#       other than "standard" (or absent) is a mismatch. Waits up to S seconds (default 120) for
#       the record: the rollout outlives the process.
#       → {result: OK|MISMATCH|MISSING, mismatches: [...], effective_config: {...}|null}
#
#   maestro-identity claude <stream-json file> --model ID --tools "A,B" --permission-mode M [--api]
#       The init event of a claude -p (or, with --api, maestro-sdk) transcript, fail closed: model is
#       ID, tools equal the set (order free; "" = none), mcp_servers empty, every plugins[].source
#       ends in @builtin, plugin_errors empty, permissionMode M, apiKeySource "none" (native: the
#       subscription) or "ANTHROPIC_API_KEY" (--api). No init event → MISSING.
#       → {result, mismatches: [...], init: {...}|null}
set -euo pipefail
. "$(dirname "$(readlink -f "$0")")/_lib.sh"

sub="${1:-}"; shift || true

case "$sub" in
  codex)
    thread="" role="" rung=1 model="" effort="" offset=0 root="" wait_s=120
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --thread) thread="$2"; shift 2 ;; --role) role="$2"; shift 2 ;; --rung) rung="$2"; shift 2 ;;
        --model) model="$2"; shift 2 ;; --effort) effort="$2"; shift 2 ;; --offset) offset="$2"; shift 2 ;;
        --root) root="$2"; shift 2 ;; --wait) wait_s="$2"; shift 2 ;;
        *) mae_die "maestro-identity codex: unknown option $1" ;;
      esac
    done
    [[ -n "$thread" && -n "$role" && -n "$model" && -n "$effort" ]] || mae_die "maestro-identity codex needs --thread, --role, --model and --effort"
    [[ "$offset" =~ ^[0-9]+$ && "$wait_s" =~ ^[0-9]+$ ]] || mae_die "--offset and --wait are whole numbers"
    case "$role" in
      critic|gate|reviewer|probe|arbiter) sandbox=read-only approval=never reviewer=user ;;
      builder|drafter|fix)
        case "$rung" in
          1) sandbox=workspace-write approval=never reviewer=user ;;
          3) sandbox=workspace-write approval=on-request reviewer=auto_review ;;
          4) sandbox=danger-full-access approval=never reviewer=user ;;
          *) mae_die "--rung is 1, 3 or 4" ;;
        esac
        [[ "$sandbox" == danger-full-access || -n "$root" ]] || mae_die "a writer needs --root (the directory it writes in)" ;;
      *) mae_die "--role is critic, gate, reviewer, probe, arbiter, builder, drafter or fix" ;;
    esac
    tc="" deadline=$(( $(date +%s) + wait_s ))
    while :; do
      r="$(mae_codex_rollout "$thread")"
      [[ -n "$r" ]] && tc="$(tail -n +$((offset + 1)) "$r" | grep -m1 '"type":"turn_context"' || true)"
      [[ -n "$tc" || $(date +%s) -ge $deadline ]] && break
      sleep 2
    done
    if [[ -z "$tc" ]]; then
      jq -cn '{result: "MISSING", mismatches: [], effective_config: null}'; exit 1
    fi
    # shellcheck disable=SC2016  # jq program
    res="$(printf '%s\n' "$tc" | jq -c --arg model "$model" --arg effort "$effort" --arg sandbox "$sandbox" \
      --arg approval "$approval" --arg reviewer "$reviewer" --arg root "$root" '
      .payload as $p | ($p.permission_profile // {}) as $pp
      | [ (if $p.model != $model then "model=\($p.model)" else empty end),
          (if $p.effort != $effort then "effort=\($p.effort)" else empty end),
          (if ($p.sandbox_policy.type // null) != $sandbox then "sandbox=\($p.sandbox_policy.type)" else empty end),
          (if $p.approval_policy != $approval then "approval_policy=\($p.approval_policy)" else empty end),
          (if $p.approvals_reviewer != $reviewer then "approvals_reviewer=\($p.approvals_reviewer)" else empty end),
          (if ($p.cyber_access_program // "standard") != "standard" then "cyber_access_program=\($p.cyber_access_program)" else empty end),
          (if $sandbox == "danger-full-access" then
             (if $pp.type != "disabled" then "permission_profile=\($pp.type)" else empty end)
           elif $pp.type != "managed" or $pp.file_system.type != "restricted"
                or ($pp.file_system.entries | type) != "array" then
             "permission_profile=\($pp.type)/\($pp.file_system.type // "none")"
           else
             (if $pp.network != "restricted" then "network=\($pp.network)" else empty end),
             (if ($p.sandbox_policy | has("network_access")) then
                (if $p.sandbox_policy.network_access != false then "network_access=\($p.sandbox_policy.network_access)" else empty end)
              elif $sandbox != "read-only" then "network_access=missing" else empty end),
             ([$pp.file_system.entries[] | select(.access == "write")
               | if .path.type == "path" then .path.path else "special:\(.path.value.kind)" end
               | select(. != "special:slash_tmp" and . != "special:tmpdir")] as $w
              | if $sandbox == "read-only" then (if $w != [] then "writable=\($w | join(","))" else empty end)
                elif $w != [$root] then "writable=\($w | join(","))" else empty end)
           end) ] as $m
      | {result: (if ($m | length) == 0 then "OK" else "MISMATCH" end), mismatches: $m,
         effective_config: {model: $p.model, effort: $p.effort, sandbox: $p.sandbox_policy.type,
                            approval_policy: $p.approval_policy, approvals_reviewer: $p.approvals_reviewer,
                            network: ($pp.network // null), cyber_access_program: ($p.cyber_access_program // null)}}' \
      2>/dev/null || true)"
    [[ -n "$res" ]] || res='{"result":"MISMATCH","mismatches":["malformed turn_context"],"effective_config":null}'
    printf '%s\n' "$res"
    [[ "$(jq -r .result <<<"$res")" == OK ]] ;;

  claude)
    f="${1:-}"; shift || true
    [[ -f "$f" ]] || mae_die "maestro-identity claude: a stream-json file first"
    model="" tools="__unset" pmode="" api=false
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --model) model="$2"; shift 2 ;; --tools) tools="$2"; shift 2 ;; --permission-mode) pmode="$2"; shift 2 ;;
        --api) api=true; shift ;;
        *) mae_die "maestro-identity claude: unknown option $1" ;;
      esac
    done
    [[ -n "$model" && "$tools" != "__unset" && -n "$pmode" ]] || mae_die "maestro-identity claude needs --model, --tools and --permission-mode"
    init="$(mae_init_event "$f")"
    if [[ -z "$init" ]]; then jq -cn '{result: "MISSING", mismatches: [], init: null}'; exit 1; fi
    # shellcheck disable=SC2016  # jq program
    res="$(jq -c --arg model "$model" --arg tools "$tools" --arg pm "$pmode" --argjson api "$api" '
      ($tools | split(",") | map(gsub("^ +| +$"; "")) | map(select(. != "")) | sort) as $want
      | [ (if .model != $model then "model=\(.model)" else empty end),
          (if ((.tools // []) | sort) != $want then "tools=\((.tools // []) | join(","))" else empty end),
          (if ((.mcp_servers // []) | length) > 0 then "mcp_servers=\([.mcp_servers[] | .name // tostring] | join(","))" else empty end),
          (if ([(.plugins // [])[] | select(((.source // "") | endswith("@builtin")) | not)] | length) > 0
             then "plugins=\([(.plugins // [])[] | .source // .name] | join(","))" else empty end),
          (if ((.plugin_errors // []) | length) > 0 then "plugin_errors=\(.plugin_errors | length)" else empty end),
          (if .permissionMode != $pm then "permissionMode=\(.permissionMode)" else empty end),
          (if (.apiKeySource // "none") != (if $api then "ANTHROPIC_API_KEY" else "none" end)
             then "apiKeySource=\(.apiKeySource // "none")" else empty end) ] as $m
      | {result: (if ($m | length) == 0 then "OK" else "MISMATCH" end), mismatches: $m,
         init: {model, tools, permissionMode, apiKeySource: (.apiKeySource // null)}}' <<<"$init")"
    printf '%s\n' "$res"
    [[ "$(jq -r .result <<<"$res")" == OK ]] ;;

  *) mae_die "usage: maestro-identity codex|claude … (--help)" ;;
esac
