#!/usr/bin/env bash
# route2-lock — one director per checkout, fenced by a generation (docs/hosts.md, "Lock").
#
#   route2-lock acquire --run R --token T --host H [--session S] [--pid P --starttime ST] [--resume]
#   route2-lock check   --gen N
#   route2-lock exec    --gen N -- <command…>     run <command> inside the fence (flock held)
#   route2-lock heartbeat --gen N
#   route2-lock release --token T [--gen N]
#   route2-lock show
#
# The lock record (.route2/lock, JSON) is {run_id, token, generation, host, session_key, liveness}.
# liveness = {kind: "pid", pid, starttime} or {kind: "heartbeat"} (then .route2/lock.heartbeat's
# mtime counts). Every read-modify-write happens under `flock -w 30` on .route2/lock.flock; the
# descriptor is closed before anything else is executed, so no child ever inherits it.
#
# Exit codes: 0 ok · 3 held by a live owner · 4 stale generation / not the owner · 5 blocked
# (jobs of the previous owner still alive) · 2 usage or I/O error.
set -euo pipefail
. "$(dirname "$(readlink -f "$0")")/_lib.sh"

SD="$(r2_state_dir)"
LOCK="$SD/lock"
LF="$SD/lock.flock"
HB="$SD/lock.heartbeat"
WAIT_S="${ROUTE2_FLOCK_WAIT:-30}"
WINDOW="${ROUTE2_HEARTBEAT_WINDOW:-1800}"

mkdir -p "$SD"
: >> "$LF"

cmd="${1:-}"; shift || true

# Parse --key value pairs into variables opt_<key> (dashes → underscores); stop at "--".
declare -A opt=()
rest=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --) shift; rest=("$@"); break ;;
    --resume) opt[resume]=1; shift ;;
    --*) k="${1#--}"; opt[${k//-/_}]="${2:-}"; shift 2 ;;
    *) rest+=("$1"); shift ;;
  esac
done

read_lock() { if [[ -f "$LOCK" ]]; then cat "$LOCK"; else echo '{}'; fi; }

# Is the recorded owner alive?  prints true|false
owner_alive() {
  local rec="$1" kind pid st age
  kind="$(jq -r '.liveness.kind // empty' <<<"$rec")"
  case "$kind" in
    pid)
      pid="$(jq -r '.liveness.pid' <<<"$rec")"; st="$(jq -r '.liveness.starttime' <<<"$rec")"
      if r2_pid_same "$pid" "$st"; then echo true; else echo false; fi ;;
    heartbeat)
      if [[ -f "$HB" ]]; then
        age=$(( $(date +%s) - $(stat -c %Y "$HB") ))
        if (( age < WINDOW )); then echo true; else echo false; fi
      else echo false; fi ;;
    *) echo false ;;
  esac
}

# Jobs recorded for a run that are not confirmed terminated (running|lingering|orphaned|uncertain).
live_jobs_of_run() {
  local run="$1" d st
  for d in "$SD"/jobs/*/; do
    [[ -f "$d/meta.json" ]] || continue
    [[ "$(jq -r '.run_id // empty' "$d/meta.json")" == "$run" ]] || continue
    st="$("$R2_BIN/route2-wait" "$(basename "$d")" --peek | jq -r '.state')"
    case "$st" in running|lingering|orphaned|uncertain) printf '%s\n' "$(basename "$d")" ;; esac
  done
}

write_lock() {  # $1 = JSON record; audited like the rest of the bookkeeping
  local gen
  gen="$(jq -r '.generation' <<<"$1")"
  r2_atomic_write "$LOCK" <<<"$1"
  r2_audit_record "$SD" lock "$gen"
}

with_flock() {  # run a shell function under the flock, descriptor closed afterwards
  local fd rc=0
  exec {fd}>>"$LF"
  if ! flock -w "$WAIT_S" "$fd"; then
    exec {fd}>&-; r2_die "lock: could not take $LF within ${WAIT_S}s"
  fi
  "$@" || rc=$?
  exec {fd}>&-
  return "$rc"
}

do_acquire() {
  local rec cur_run cur_token gen alive live_jobs liveness new
  [[ -n "${opt[run]:-}" && -n "${opt[token]:-}" && -n "${opt[host]:-}" ]] \
    || r2_die "acquire needs --run, --token and --host"
  rec="$(read_lock)"
  if [[ -f "$LOCK" ]] && ! r2_audit_verify "$SD" lock; then
    jq -cn '{result: "tampered", file: "lock"}'; return 5
  fi
  cur_run="$(jq -r '.run_id // empty' <<<"$rec")"
  cur_token="$(jq -r '.token // empty' <<<"$rec")"
  gen="$(jq -r '.generation // 0' <<<"$rec")"
  # The generation never goes back: after a release the counter in lock.gen continues it.
  if [[ -f "$SD/lock.gen" ]] && (( $(cat "$SD/lock.gen") > gen )); then gen="$(cat "$SD/lock.gen")"; fi
  if [[ -n "${opt[pid]:-}" ]]; then
    liveness="$(jq -cn --arg p "${opt[pid]}" --arg s "${opt[starttime]:-}" '{kind:"pid", pid:($p|tonumber), starttime:$s}')"
  else
    liveness='{"kind":"heartbeat"}'
  fi

  if [[ -n "$cur_run" ]]; then
    alive="$(owner_alive "$rec")"
    # Re-entrant: the same live owner (same token and the same liveness) gets the same generation.
    if [[ "$cur_token" == "${opt[token]}" && "$alive" == true \
          && "$(jq -c '.liveness' <<<"$rec")" == "$liveness" ]]; then
      jq -cn --argjson g "$gen" '{result: "reentrant", generation: $g}'; return 0
    fi
    if [[ "$alive" == true ]]; then
      jq -cn --argjson owner "$rec" '{result: "held", owner: $owner}'; return 3
    fi
    # Stale owner.
    if [[ -n "${opt[resume]:-}" ]]; then
      [[ "$cur_run" == "${opt[run]}" && "$cur_token" == "${opt[token]}" ]] || {
        jq -cn --argjson owner "$rec" '{result: "held", reason: "resume of a different run or token", owner: $owner}'
        return 3; }
    else
      live_jobs="$(live_jobs_of_run "$cur_run")"
      if [[ -n "$live_jobs" ]]; then
        jq -cn --arg jobs "$live_jobs" --argjson owner "$rec" \
          '{result: "blocked", jobs: ($jobs | split("\n") | map(select(. != ""))), owner: $owner}'
        return 5
      fi
    fi
  fi

  new="$(jq -cn --arg run "${opt[run]}" --arg token "${opt[token]}" --argjson g "$((gen + 1))" \
    --arg host "${opt[host]}" --arg s "${opt[session]:-}" --argjson l "$liveness" --arg at "$(r2_now)" \
    '{run_id: $run, token: $token, generation: $g, host: $host,
      session_key: (if $s == "" then null else $s end), liveness: $l, acquired_at: $at}')"
  write_lock "$new"
  printf '%s' "$((gen + 1))" > "$SD/lock.gen"
  if [[ "$(jq -r '.kind' <<<"$liveness")" == heartbeat ]]; then touch "$HB"; fi
  local adopted=""
  [[ -n "${opt[resume]:-}" ]] && adopted="$(live_jobs_of_run "${opt[run]}")"
  jq -cn --argjson g "$((gen + 1))" --arg a "$adopted" \
    '{result: "acquired", generation: $g, adopted_jobs: ($a | split("\n") | map(select(. != "")))}'
}

check_gen_unlocked() {  # caller holds the flock
  local rec gen
  rec="$(read_lock)"
  gen="$(jq -r '.generation // empty' <<<"$rec")"
  [[ -n "${opt[gen]:-}" && "$gen" == "${opt[gen]}" ]] || {
    r2_warn "fence: generation ${opt[gen]:-?} is not current (${gen:-none}) — this director was superseded"
    return 4; }
  r2_audit_verify "$SD" lock || return 4
}

do_release() {
  local rec
  rec="$(read_lock)"
  [[ "$(jq -r '.token // empty' <<<"$rec")" == "${opt[token]:-}" ]] || { r2_warn "release: token mismatch"; return 4; }
  if [[ -n "${opt[gen]:-}" ]]; then check_gen_unlocked || return 4; fi
  rm -f "$LOCK" "$HB"
  r2_audit_record "$SD" lock "release"
  jq -cn '{result: "released"}'
}

do_heartbeat() { check_gen_unlocked || return 4; touch "$HB"; }

case "$cmd" in
  acquire)   with_flock do_acquire ;;
  check)     with_flock check_gen_unlocked && jq -cn --arg g "${opt[gen]}" '{result: "current", generation: ($g|tonumber)}' ;;
  heartbeat) with_flock do_heartbeat ;;
  release)   with_flock do_release ;;
  show)      read_lock ;;
  exec)
    r2_in_fence && r2_die "nested route2-lock exec refused (already inside the fence)"
    [[ ${#rest[@]} -gt 0 ]] || r2_die "exec needs -- <command…>"
    # flock -o: the lock descriptor is closed before <command> is executed; flock(1) itself holds
    # the lock until <command> exits. The inner call checks the generation under that lock.
    exec flock -w "$WAIT_S" -o "$LF" env ROUTE2_IN_FENCE=1 "$0" __exec_locked --gen "${opt[gen]:-}" -- "${rest[@]}" ;;
  __exec_locked)
    check_gen_unlocked || exit 4
    [[ -f "$HB" ]] && touch "$HB"
    exec "${rest[@]}" ;;
  *) r2_die "usage: route2-lock acquire|check|exec|heartbeat|release|show …" ;;
esac
