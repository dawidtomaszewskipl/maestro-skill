#!/usr/bin/env bash
# route2-kill — stop a job without ever signalling a test (docs/hosts.md, "Jobs").
#
#   route2-kill <job-id> --gen F [--grace S]
#
# One step per call (a host may cap a foreground command, so the director calls it again until
# the result is final). Prints {job_id, result, …}:
#   waiting-tests  protected test processes are alive; nothing was signalled (call again later)
#   signalled      SIGTERM sent to the remaining members, individually (call again after --grace)
#   killed         SIGKILL sent to members still alive after the grace period (call again)
#   done           terminated: {state: exited|lost}
#   blocked        a member's relation to the job or to its tests cannot be established, a member
#                  survives SIGKILL, or /proc is uncertain — nothing more is signalled
#
# Protected = test roots (a member whose recorded OR current command line equals a recorded test
# command, or holds a recorded test-runner path such as vendor/bin/pest) + every descendant of a
# test root + shell wrappers between the leader and a test root. The whole classification runs
# again INSIDE the fence immediately before any signal; a test root or an unclassifiable member
# found there means nothing is signalled and kill.state does not advance. Signals go to members one
# by one, never to the process group.
set -euo pipefail
. "$(dirname "$(readlink -f "$0")")/_lib.sh"

SD="$(r2_state_dir)"

# classify <jobdir> → JSON array of live members:
#   {pid, starttime, argv, argv_now, leader, test, wrapper_of_test, classifiable}
# Recorded members use their recorded ancestry (original ppid). A live member the recorder never
# saw (recovered from the process group) gets its CURRENT ancestry walked through /proc: it is
# classifiable only if that walk reaches a recorded member or the wrapper, and it is protected if
# anything on the way is (or descends from) a test root.
classify() {
  local J="$1" snap pid pst wpid live p chain q n job
  job="$(basename "$J")"
  snap="$("$R2_BIN/route2-wait" "$job" --peek)"
  # The live set could not be established: say so instead of classifying a partial set.
  if [[ "$(jq -r .state <<<"$snap")" == uncertain ]]; then echo '"UNCERTAIN"'; return 0; fi
  pid="$(jq -r '.pid // empty' "$J/meta.json")"; pst="$(jq -r '.pid_starttime // empty' "$J/meta.json")"
  wpid="$(jq -r '.wrapper_pid // empty' "$J/meta.json")"
  live="$(jq -c '.live_members // []' <<<"$snap" | jq -c '.[]' | while IFS= read -r m; do
      p="$(jq -r .pid <<<"$m")"
      chain="[]"
      if [[ "$(jq -r '.unrecorded // false' <<<"$m")" == true ]]; then
        q="$p"; n=0
        while [[ -n "$q" && "$q" -gt 1 && $n -lt 64 ]]; do
          q="$(r2_pid_ppid "$q")"; [[ -n "$q" ]] || break
          chain="$(jq -c --arg q "$q" --arg a "$(r2_pid_cmdline "$q")" --arg s "$(r2_pid_starttime "$q")" \
                    '. + [{pid: ($q|tonumber), starttime: $s, argv_now: $a}]' <<<"$chain")"
          n=$((n + 1))
        done
      fi
      jq -c --arg cur "$(r2_pid_cmdline "$p")" --argjson ch "$chain" '. + {argv_now: $cur, chain_now: $ch}' <<<"$m"
    done | jq -sc .)"
  if [[ -n "$pid" ]] && r2_pid_same "$pid" "$pst"; then
    live="$(jq -c --arg p "$pid" --arg s "$pst" --arg a "$(r2_pid_cmdline "$pid")" \
      '. + [{pid: ($p|tonumber), starttime: $s, ppid: null, argv: $a, argv_now: $a, leader: true, chain_now: []}]' <<<"$live")"
  fi
  # shellcheck disable=SC2016  # jq program
  jq -c --slurpfile rec <(cat "$J/members.jsonl" 2>/dev/null || true) \
    --argjson meta "$(cat "$J/meta.json")" --arg w "${wpid:-0}" '
    ($rec | map({key: (.pid | tostring), value: .}) | from_entries) as $byp
    | def chain: [recurse(($byp[tostring].ppid) // empty)] | map(tostring);
      def is_shell: ((.exe // "") | test("/(ba|da|z)?sh$")) or ((.argv // "") | test("^(\\S*/)?(ba|da|z)?sh( |$)"));
      def runner_in($argv): [ ($meta.test_runners // [])[] as $r | ($argv | split(" "))[]
                              | select(. == $r or endswith("/" + $r)) ] | length > 0;
      def is_test_argv($a): ((($meta.test_cmds // []) | index($a)) != null) or runner_in($a);
      def is_test_root: [ .argv, (.argv_now // empty) ] | map(select(. != null)) | any(. as $a | is_test_argv($a));
      ([ $rec[] | select(is_test_root) | .pid | tostring ] + [ .[] | select(is_test_root) | .pid | tostring ]) as $roots
    | ((($meta.test_cmds // []) | length) == 0 and (($meta.test_runners // []) | length) == 0 and ($roots | length) == 0) as $no_tests
    | ($rec | map(.pid | tostring)) as $recorded
    | map(. as $m
        | (if (($m.chain_now // []) | length) > 0
           then ($m.chain_now | map(.pid | tostring)) as $now
                | ([ $now | to_entries[] | .value as $v | select(($v == $w) or (($recorded | index($v)) != null)) | .key ] | first) as $hit
                | {reached: ($hit != null),
                   chain: ([$m.pid | tostring] + (if $hit != null then $now[0:$hit + 1] + ($now[$hit] | if . == $w then [] else (tonumber | chain) end) else $now end)),
                   test_on_way: ([ $m.chain_now[0:(if $hit != null then $hit + 1 else 0 end)][] | select(is_test_argv(.argv_now)) ] | length > 0)}
           else {reached: false, chain: ($m.pid | chain), test_on_way: false} end) as $c
        | $m + {chain: $c.chain,
                test: (($c.chain | any(. as $x | $roots | index($x) != null)) or $c.test_on_way),
                # Proven safe to signal: the leader; a member whose ancestry reaches the wrapper; an
                # unrecorded member whose current ancestry reaches a recorded member. A recorded
                # member whose parent is unknown (re-parented before the first poll) is a proven
                # member (its process group), but its relation to tests is unknown: safe only when
                # the job has no tests at all — otherwise it blocks (fail closed).
                classifiable: (($m.leader // false) or ($c.chain | index($w) != null)
                               or (($m.unrecorded // false) and $c.reached)
                               or ((($m.unrecorded // false) | not) and $no_tests
                                   and ((($byp[$m.pid | tostring].pgid) // -1 | tostring) == $w)))})
    | . as $all
    | map(. as $m | . + {wrapper_of_test: ((($m | is_shell) and
          ([ $all[] | select(.test and (.pid != $m.pid)) | .chain | index($m.pid | tostring) != null ] | any)))})
    | map(del(.chain, .chain_now))' <<<"$live"
}

# decide <jobdir> <classified> → prints a JSON verdict and returns 0 when nothing may be signalled.
decide() {
  local J="$1" c="$2"
  if [[ "$c" == '"UNCERTAIN"' ]]; then
    jq -cn --arg j "$(basename "$J")" '{job_id: $j, result: "blocked", reason: "proc uncertain: the live set of the job cannot be established"}'
    return 0
  fi
  if jq -e 'any(.[]; .classifiable | not)' <<<"$c" >/dev/null; then
    jq -cn --arg j "$(basename "$J")" --argjson c "$c" '{job_id: $j, result: "blocked", reason: "a member whose relation to the job or its tests cannot be established", members: $c}'
    return 0
  fi
  if jq -e 'any(.[]; .test or .wrapper_of_test)' <<<"$c" >/dev/null; then
    jq -cn --arg j "$(basename "$J")" --argjson c "$c" '{job_id: $j, result: "waiting-tests", protected: [ $c[] | select(.test or .wrapper_of_test) | {pid, argv: (.argv_now // .argv)} ]}'
    return 0
  fi
  if [[ "$(jq 'length' <<<"$c")" == 0 ]]; then
    jq -cn --arg j "$(basename "$J")" '{job_id: $j, result: "done", state: "lost"}'
    return 0
  fi
  return 1
}

if [[ "${1:-}" == "__step" ]]; then   # inside the fence: __step <jobdir> <TERM|KILL>
  J="$2" sig="$3"
  c="$(classify "$J")"
  if decide "$J" "$c"; then exit 0; fi      # something changed since the outer look: nothing signalled
  mapfile -t targets < <(jq -r '.[] | "\(.pid):\(.starttime)"' <<<"$c")
  for ps in "${targets[@]}"; do
    p="${ps%%:*}"; s="${ps#*:}"
    if r2_pid_same "$p" "$s"; then kill "-$sig" "$p" 2>/dev/null || true; fi
  done
  now="$(date +%s)"; ks="$(cat "$J/kill.state" 2>/dev/null || echo '{}')"
  if [[ "$sig" == TERM ]]; then
    jq -c --argjson t "$now" '. + {term_at: $t}' <<<"$ks" | r2_atomic_write "$J/kill.state"; r=signalled
  else
    jq -c --argjson t "$now" '. + {kill_at: $t}' <<<"$ks" | r2_atomic_write "$J/kill.state"; r=killed
  fi
  jq -cn --arg j "$(basename "$J")" --arg r "$r" --argjson n "${#targets[@]}" '{job_id: $j, result: $r, count: $n}'
  exit 0
fi

job="${1:-}"; shift || true
gen="" grace="${ROUTE2_KILL_GRACE:-10}"
while [[ $# -gt 0 ]]; do
  case "$1" in
    --gen) gen="$2"; shift 2 ;;
    --grace) grace="$2"; shift 2 ;;
    *) r2_die "route2-kill: unknown option $1" ;;
  esac
done
[[ -n "$job" && -n "$gen" ]] || r2_die "usage: route2-kill <job-id> --gen F [--grace S]"
J="$SD/jobs/$job"
[[ -f "$J/meta.json" ]] || r2_die "route2-kill: no job $job"
if [[ "$(jq -r .kind "$J/meta.json")" == test ]]; then
  jq -cn --arg j "$job" '{job_id: $j, result: "refused", reason: "test jobs are never killed"}'; exit 0
fi

state="$("$R2_BIN/route2-wait" "$job" --peek | jq -r .state)"
case "$state" in
  exited|lost) jq -cn --arg j "$job" --arg s "$state" '{job_id: $j, result: "done", state: $s}'; exit 0 ;;
  uncertain)   jq -cn --arg j "$job" '{job_id: $j, result: "blocked", reason: "proc uncertain"}'; exit 0 ;;
esac

# Outer look (outside the fence: waiting for tests never holds the lock).
c="$(classify "$J")"
if decide "$J" "$c"; then exit 0; fi

ks="$(cat "$J/kill.state" 2>/dev/null || echo '{}')"
term_at="$(jq -r '.term_at // empty' <<<"$ks")"
now="$(date +%s)"
if [[ -z "$term_at" ]]; then
  "$R2_BIN/route2-lock" exec --gen "$gen" -- "$0" __step "$J" TERM || exit 4
elif (( now - term_at < grace )); then
  jq -cn --arg j "$job" --argjson left "$(( grace - (now - term_at) ))" '{job_id: $j, result: "signalled", grace_left_s: $left}'
elif [[ -z "$(jq -r '.kill_at // empty' <<<"$ks")" ]]; then
  "$R2_BIN/route2-lock" exec --gen "$gen" -- "$0" __step "$J" KILL || exit 4
else
  jq -cn --arg j "$job" --argjson c "$c" '{job_id: $j, result: "blocked", reason: "members survived SIGKILL", members: $c}'
fi
