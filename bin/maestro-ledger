#!/usr/bin/env bash
# maestro-ledger — build a complete ledger row from a job's output and append it (docs/ledger.md).
#
#   maestro-ledger --gen N --job <id> --stage <stage> --cli codex|agy|claude-cli|cursor-agent
#                 --transport native|agy|cursor|codex --family <family> --model <requested>
#                 [--effort E] [--round R] [--outcome TEXT] [--verdict V]
#                 [--effective-config JSON|TEXT] [--service-tier TIER] [--run ID] [--host H] [--dry-run]
#   maestro-ledger --gen N --cli claude-agent --stage <stage> --transport native --family claude
#                 --model <alias> --served <model id> --agent-id <id> --total-tokens N
#                 [--tool-uses N] [--duration-ms N] [--status success|error] [other options as above]
#       An Agent-tool call (interactive Claude Code) has no job: its numbers come from the
#       subagent's completion (total tokens, tool uses, duration — the harness reports no split
#       into input and output, so those fields stay null) and job_id is null.
#
# Reads .maestro/jobs/<id>/: `out` (the event stream or envelope), `answer` (codex -o), `exit`,
# `meta.json`. run_id and host come from meta.json (a maestro-run job), else from --run/--host,
# else from the lock record — an interactive Claude Code launches with the Bash tool's background
# mode, so its job directories have no meta.json. Usage is taken from the CLI's own fields —
# codex: the last turn.completed.usage; agy: the envelope's usage (cumulative per conversation: kept raw in raw_cumulative); claude-cli:
# the result event's usage and modelUsage; cursor-agent: the result event's usage and init.model.
# Codex resumes and agy conversations report CUMULATIVE usage: the raw counters go into
# raw_cumulative and the token fields get the delta against the previous row of the same session.
# Missing numbers are null, never estimated. Appends through maestro-state (audited); --dry-run
# prints the row instead.
set -euo pipefail
. "$(dirname "$(readlink -f "$0")")/_lib.sh"

SD="$(mae_state_dir)"
gen="" job="" stage="" cli="" transport="" family="" model="" effort="" round="" outcome="" verdict="" effcfg="" tier="" dry=0
run_opt="" host_opt="" served_opt="" agent_id="" total_opt="" tool_uses="" dur_ms="" status_opt=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --gen) gen="$2"; shift 2 ;;
    --job) job="$2"; shift 2 ;;
    --stage) stage="$2"; shift 2 ;;
    --cli) cli="$2"; shift 2 ;;
    --transport) transport="$2"; shift 2 ;;
    --family) family="$2"; shift 2 ;;
    --model) model="$2"; shift 2 ;;
    --effort) effort="$2"; shift 2 ;;
    --round) round="$2"; shift 2 ;;
    --outcome) outcome="$2"; shift 2 ;;
    --verdict) verdict="$2"; shift 2 ;;
    --effective-config) effcfg="$2"; shift 2 ;;
    --service-tier) tier="$2"; shift 2 ;;
    --served) served_opt="$2"; shift 2 ;;
    --agent-id) agent_id="$2"; shift 2 ;;
    --total-tokens) total_opt="$2"; shift 2 ;;
    --tool-uses) tool_uses="$2"; shift 2 ;;
    --duration-ms) dur_ms="$2"; shift 2 ;;
    --status) status_opt="$2"; shift 2 ;;
    --run) run_opt="$2"; shift 2 ;;
    --host) host_opt="$2"; shift 2 ;;
    --dry-run) dry=1; shift ;;
    *) mae_die "maestro-ledger: unknown option $1" ;;
  esac
done
[[ -n "$stage" && -n "$cli" && -n "$model" ]] || mae_die "maestro-ledger needs --stage, --cli and --model"
num() { [[ -z "$2" || "$2" =~ ^[0-9]+$ ]] || mae_die "maestro-ledger: $1 must be a whole number"; }
num --total-tokens "$total_opt"; num --tool-uses "$tool_uses"; num --duration-ms "$dur_ms"
if [[ "$cli" == claude-agent ]]; then
  [[ -z "$job" ]] || mae_die "maestro-ledger: an Agent-tool call has no job (drop --job)"
  [[ -n "$served_opt" && -n "$agent_id" && -n "$total_opt" ]] \
    || mae_die "maestro-ledger --cli claude-agent needs --served, --agent-id and --total-tokens (from the completion)"
  J="$SD/jobs/.none"; out=/dev/null
else
  [[ -n "$job" ]] || mae_die "maestro-ledger needs --job"
  J="$SD/jobs/$job"
  [[ -d "$J" ]] || mae_die "maestro-ledger: no job $job"
  out="$J/out"; [[ -f "$out" ]] || out=/dev/null
fi

case "$cli" in
  codex)
    u="$(grep '"turn.completed"' "$out" | tail -1 | jq -c '.usage // {}' 2>/dev/null || echo '{}')"
    sid="$(grep -m1 '"thread.started"' "$out" | jq -r '.thread_id // empty' 2>/dev/null || true)"
    usage="$(jq -c '{input_tokens, cached_input_tokens, cache_write_input_tokens, output_tokens,
                     reasoning_tokens: .reasoning_output_tokens}' <<<"$u")"
    status="$(if grep -q '"turn.failed"' "$out"; then echo failed; elif grep -q '"turn.completed"' "$out"; then echo completed; else echo incomplete; fi)"
    denied=null; served=null; dur=null
    # The served model is the thread's latest turn_context in its rollout (the effective-config source).
    if [[ -n "$sid" ]]; then
      ro="$(find "${CODEX_HOME:-$HOME/.codex}/sessions" -name "rollout-*-$sid.jsonl" 2>/dev/null | head -1 || true)"
      if [[ -n "$ro" ]]; then
        m="$( { grep '"type":"turn_context"' "$ro" || true; } | tail -1 | jq -r '.payload.model // empty' 2>/dev/null || true)"
        [[ -n "$m" ]] && served="$(jq -cn --arg m "$m" '$m')"
      fi
    fi ;;
  agy)
    env_="$(jq -c . "$out" 2>/dev/null || echo '{}')"
    sid="$(jq -r '.conversation_id // empty' <<<"$env_")"
    usage="$(jq -c '(.usage // {}) | {input_tokens, cached_input_tokens: .cache_read_tokens, cache_write_input_tokens: null,
                     output_tokens, reasoning_tokens: .thinking_tokens, total_tokens}' <<<"$env_")"
    status="$(jq -r '.status // "none"' <<<"$env_")"; denied="$(jq -c '[(.denied_actions // [])[].action]' <<<"$env_")"
    served=null; dur="$(jq -c '.duration_seconds // null' <<<"$env_")" ;;
  claude-cli)
    res="$(jq -c 'select(.type == "result")' "$out" 2>/dev/null | tail -1)"; [[ -n "$res" ]] || res='{}'
    sid="$(jq -r '.session_id // empty' <<<"$res")"
    usage="$(jq -c '(.usage // {}) | {input_tokens, cached_input_tokens: .cache_read_input_tokens,
                     cache_write_input_tokens: .cache_creation_input_tokens, output_tokens, reasoning_tokens: null}' <<<"$res")"
    served="$(jq -c '(.modelUsage // {}) | keys | if length == 0 then null else join(",") end' <<<"$res")"
    status="$(jq -r '.subtype // "none"' <<<"$res")"; denied="$(jq -c '[(.permission_denials // [])[].tool_name]' <<<"$res")"
    dur="$(jq -c 'if .duration_ms then .duration_ms / 1000 else null end' <<<"$res")" ;;
  cursor-agent)
    res="$(jq -c 'select(.type == "result")' "$out" 2>/dev/null | tail -1)"; [[ -n "$res" ]] || res='{}'
    sid="$(jq -r '.session_id // empty' <<<"$res")"
    usage="$(jq -c '(.usage // {}) | {input_tokens: .inputTokens, cached_input_tokens: .cacheReadTokens,
                     cache_write_input_tokens: .cacheWriteTokens, output_tokens: .outputTokens, reasoning_tokens: null}' <<<"$res")"
    served="$(jq -c 'select(.type == "system" and .subtype == "init") | .model' "$out" 2>/dev/null | head -1)"
    [[ -n "$served" ]] || served=null
    status="$(jq -r '.subtype // "none"' <<<"$res")"; denied=null
    dur="$(jq -c 'if .duration_ms then .duration_ms / 1000 else null end' <<<"$res")" ;;
  claude-agent)
    sid="$agent_id"
    usage="$(jq -cn --argjson t "$total_opt" '{input_tokens: null, cached_input_tokens: null,
                     cache_write_input_tokens: null, output_tokens: null, reasoning_tokens: null, total_tokens: $t}')"
    served="$(jq -cn --arg m "$served_opt" '$m')"
    status="${status_opt:-success}"; denied=null
    dur="$(if [[ -n "$dur_ms" ]]; then jq -n --argjson d "$dur_ms" '$d / 1000'; else echo null; fi)" ;;
  *) mae_die "maestro-ledger: --cli is codex, agy, claude-cli, cursor-agent or claude-agent" ;;
esac

# Cumulative counters (codex resume, agy conversation). Per COUNTER: the baseline is the last
# earlier row of this session where that counter was a number; the delta is current − baseline. A
# counter that is missing now stays null (unknown usage is never filled with a cumulative total)
# and leaves its baseline in place for the next row. A counter that went DOWN marks a reset: from
# there its raw value is this call's own usage.
raw=null counter_reset=false
if [[ "$cli" == codex || "$cli" == agy ]] && [[ -n "$sid" ]] \
   && jq -e 'to_entries | any((.value | type) == "number")' <<<"$usage" >/dev/null; then
  raw="$usage"
  rows="$( { jq -c --arg s "$sid" 'select(.session_id == $s and .raw_cumulative != null) | .raw_cumulative' "$SD/ledger.jsonl" 2>/dev/null || true; } | jq -sc .)"
  res="$(jq -c --argjson rows "$rows" '
    . as $cur
    | reduce (keys_unsorted[]) as $k ({u: {}, reset: false};
        ($cur[$k]) as $v
        | ([ $rows[] | .[$k] | select(type == "number") ] | last) as $b
        | if ($v | type) != "number" then .u[$k] = $v
          elif $b == null then .u[$k] = $v
          elif $v < $b then .u[$k] = $v | .reset = true
          else .u[$k] = ($v - $b) end)' <<<"$raw")"
  usage="$(jq -c .u <<<"$res")"
  [[ "$(jq -r .reset <<<"$res")" == true ]] && counter_reset=true
fi

meta='{}'; [[ -f "$J/meta.json" ]] && meta="$(cat "$J/meta.json")"
# Fill run_id and host where meta.json has none: the options first, then the lock record.
lockinfo='{}'; [[ -f "$SD/lock" ]] && lockinfo="$(jq -c '{run_id, host}' "$SD/lock" 2>/dev/null || echo '{}')"
meta="$(jq -c --argjson l "$lockinfo" --arg r "$run_opt" --arg h "$host_opt" '
  def nn: if . == "" then null else . end;
  . + {run_id: (.run_id // ($r | nn) // $l.run_id // null), host: (.host // ($h | nn) // $l.host // null)}' <<<"$meta")"
code=null; [[ -f "$J/exit" ]] && code="$(jq -Rc . < "$J/exit")"
row="$(jq -cn --arg ts "$(mae_now)" --argjson meta "$meta" --arg stage "$stage" --arg cli "$cli" \
  --arg transport "$transport" --arg family "$family" --arg model "$model" --argjson served "${served:-null}" \
  --arg effort "$effort" --arg round "$round" --arg sid "$sid" --arg job "$job" --argjson usage "$usage" \
  --argjson dur "${dur:-null}" --argjson code "$code" --arg outcome "$outcome" --arg verdict "$verdict" \
  --argjson raw "$raw" --arg status "$status" --argjson denied "${denied:-null}" --arg effcfg "$effcfg" \
  --arg tier "$tier" --argjson reset "$counter_reset" --arg tu "$tool_uses" '
  def nn: if . == "" then null else . end;
  {ts: $ts, run_id: ($meta.run_id // null), host: ($meta.host | nn), stage: $stage,
   round: ($round | nn | if . then tonumber? // . else null end), cli: $cli, transport: ($transport | nn),
   family: ($family | nn), model_requested: $model, model_served: $served, effort: ($effort | nn),
   session_id: ($sid | nn), job_id: ($job | nn), duration_s: $dur}
  + $usage
  + {total_tokens: ($usage.total_tokens // (if $usage.input_tokens and $usage.output_tokens then $usage.input_tokens + $usage.output_tokens else null end)),
     raw_cumulative: $raw, status: ($status | nn), denied_actions: $denied,
     effective_config: ($effcfg | nn | if . == null then null else (. as $t | try ($t | fromjson) catch $t) end),
     service_tier_requested: ($tier | nn), service_tier_observed: null,
     counter_reset: (if $reset then true else null end),
     tool_uses: ($tu | nn | if . == null then null else tonumber end),
     exit_code: $code, outcome: ($outcome | nn), verdict: ($verdict | nn)}')"
if [[ $dry -eq 1 ]]; then printf '%s\n' "$row"; exit 0; fi
[[ -n "$gen" ]] || mae_die "maestro-ledger needs --gen N (or --dry-run)"
printf '%s\n' "$row" | "$MAESTRO_BIN/maestro-state" --gen "$gen" append ledger.jsonl
