#!/usr/bin/env bash
# maestro-wait — report or wait for a job's state (docs/hosts.md, "Jobs").
#
#   maestro-wait <job-id> [--max S] [--peek] [--also FILE]
#   maestro-wait <job-id> --until-done [--max S] [--also FILE]
#
# Prints one JSON line: {job_id, state, code, leader_alive, elapsed, last_progress_at, progress_source,
# live_members, unowned}. state:
#   running    the leader (or the wrapper finishing it) is alive
#   exited     exit written and no member left — terminated; success only for code "0"
#   lingering  exit written but members remain (e.g. a writer left a background process)
#   orphaned   leader gone, no exit, members remain
#   lost       leader gone, no exit, no member left — terminated, outcome unknown
#   uncertain  /proc, the leader or a member unreadable (the leader may still be alive: see
#              leader_alive) — never counted as terminated; blocks like running while the leader lives
# Blocks up to --max seconds (default $MAESTRO_WAIT_MAX or 100: the Bash tool's default cap is 120 s;
# with `timeout: 600000` pass --max 540) while running; --peek never blocks
# and never updates the progress record. --also FILE counts FILE's growth as progress too (agy's
# CLI log). Progress = new bytes on stdout, or on stderr/--also with a last line different from
# the previous one (a repeated identical error line is not progress).
#
# --until-done blocks with no cap (MAESTRO_WAIT_MAX does not apply) until the job needs the
# director: it keeps waiting on `running` and on `uncertain` with leader_alive, and returns on
# everything else — exited and lost (terminated), lingering and orphaned (they need maestro-kill,
# waiting would never end), uncertain without a live leader. Prints that one snapshot, exit 0. An
# explicit --max caps it: still waiting at the deadline → the snapshot and exit 3. An interactive
# director runs it as the one background Bash task whose completion notification wakes it; it
# keeps the progress record current, so pass the job's --also here.
set -euo pipefail
. "$(dirname "$(readlink -f "$0")")/_lib.sh"

SD="$(mae_state_dir)"
job="${1:-}"; shift || true
max="${MAESTRO_WAIT_MAX:-100}" peek=0 also="" until=0 max_set=0
while [[ $# -gt 0 ]]; do
  case "$1" in
    --max) max="$2"; max_set=1; shift 2 ;;
    --peek) peek=1; shift ;;
    --until-done) until=1; shift ;;
    --also) also="$2"; shift 2 ;;
    *) mae_die "maestro-wait: unknown option $1" ;;
  esac
done
[[ -n "$job" ]] || mae_die "usage: maestro-wait <job-id> [--max S] [--peek | --until-done] [--also FILE]"
[[ $until -eq 0 || $peek -eq 0 ]] || mae_die "maestro-wait: --until-done and --peek exclude each other"
[[ "$max" =~ ^[0-9]+$ ]] || mae_die "maestro-wait: --max takes whole seconds"
J="$(mae_job_dir "$SD" "$job")"
[[ -d "$J" ]] || mae_die "maestro-wait: no job $job"

snapshot() {
  local leader_alive=false wrapper_alive=false code="" state live="[]" unowned="[]"
  if [[ ! -r "$(mae_proc)/self/stat" && ! -r "$(mae_proc)/1/stat" ]]; then
    jq -cn --arg j "$job" '{job_id: $j, state: "uncertain", reason: "/proc unreadable"}'; return
  fi
  [[ -f "$J/exit" ]] && code="$(cat "$J/exit")"
  if [[ ! -f "$J/meta.json" ]]; then
    if [[ "$code" == "launch-failed" ]]; then
      jq -cn --arg j "$job" '{job_id: $j, state: "exited", code: "launch-failed"}'
    else
      jq -cn --arg j "$job" '{job_id: $j, state: "uncertain", reason: "meta.json missing"}'
    fi
    return
  fi
  # meta.json is immutable after launch: one read per snapshot.
  local pid st wpid pg cwd want started
  IFS=$'\x1f' read -r pid st wpid pg cwd started want < <(jq -r '[(.pid // ""), (.pid_starttime // ""), (.wrapper_pid // ""),
      (.pgid // ""), (.cwd // ""), ((.started_at // "") | (try fromdateiso8601 catch "")),
      ([(.cmd | join(" ")), (.leader_argv // empty)] + (.test_cmds // []) | tojson)] | map(tostring) | join("\u001f")' "$J/meta.json")
  local leader_unreadable=0
  if [[ -n "$pid" ]]; then
    if mae_pid_same "$pid" "$st"; then leader_alive=true
    elif [[ -d "$(mae_proc)/$pid" && ! -r "$(mae_proc)/$pid/stat" ]]; then leader_unreadable=1; fi
  fi
  if [[ -n "$wpid" ]] && kill -0 "$wpid" 2>/dev/null \
     && [[ "$(mae_pid_cmdline "$wpid")" == *"__wrapper $J"* ]]; then wrapper_alive=true; fi

  # Live members: recorded (pid, starttime) pairs still alive, leader excluded — plus any live
  # process still in the job's process group that the recorder never saw (the wrapper may have
  # died between polls). A recorded pid whose /proc entry exists but cannot be read makes the
  # state uncertain: it is never counted as gone.
  local unreadable=0 alive=() p s
  if [[ -f "$J/members.jsonl" ]]; then
    while IFS=$'\x1f' read -r p s; do
      [[ -n "$p" && "$p" != "${pid:-0}" ]] || continue
      if mae_pid_same "$p" "$s"; then alive+=("$p:$s")
      elif [[ -d "$(mae_proc)/$p" && ! -r "$(mae_proc)/$p/stat" ]]; then unreadable=1; fi
    done < <(jq -r '[(.pid|tostring), (.starttime // "" | tostring)] | join("\u001f")' "$J/members.jsonl" 2>/dev/null || true)
    if [[ ${#alive[@]} -gt 0 ]]; then
      live="$(jq -sc --arg keys " ${alive[*]} " 'map(. as $m | select($keys | contains(" \($m.pid):\($m.starttime) "))) | unique_by(.pid)' "$J/members.jsonl")"
    fi
  fi
  if [[ -n "$pg" ]]; then
    # One pass over /proc/*/stat: pids whose process group is the job's.
    # shellcheck disable=SC2013  # awk prints one pid per line; word splitting is what we want
    for p in $(mae_proc_table | awk -v pg="$pg" '$3 == pg { print $1 }'); do
      [[ "$p" == "${pid:-0}" || "$p" == "${wpid:-0}" || "$p" == "$$" ]] && continue
      # The wrapper's own children other than the leader (its poll `sleep`, its last member scan)
      # are infrastructure, not members.
      [[ -n "${wpid:-}" && "$(mae_pid_ppid "$p")" == "$wpid" ]] && continue
      [[ "$(mae_pid_cmdline "$p")" == *"__wrapper $J"* ]] && continue
      jq -e --arg p "$p" 'any(.[]; (.pid|tostring) == $p)' <<<"$live" >/dev/null && continue
      # Read the identity once: a process that is gone is not a member; one whose entry still
      # exists but cannot be read makes the whole state uncertain (never "gone").
      id="$(mae_pid_identity "$p")"
      case "$id" in
        gone) continue ;;
        unreadable) unreadable=1; continue ;;
      esac
      live="$(jq -c --arg p "$p" --arg st "$id" --arg a "$(mae_pid_cmdline "$p")" \
        --arg pg "$pg" '. + [{pid: ($p|tonumber), starttime: $st, argv: $a, pgid: ($pg|tonumber), unrecorded: true}]' <<<"$live")"
    done
  fi

  # The wrapper records the last members and writes exit before it quits. A job that ended between
  # the first read of exit and the liveness checks would otherwise look dead without a code (lost):
  # read it again — but only when the wrapper was already gone at its check, so its final member
  # scan happened before members.jsonl was read above. A wrapper seen alive keeps the job running.
  [[ -z "$code" && "$wrapper_alive" != true && -f "$J/exit" ]] && code="$(cat "$J/exit")"

  # An unreadable leader or member outranks everything, a live leader included: the live set is
  # incomplete, and maestro-kill must never classify (or signal) an incomplete set.
  if (( unreadable || leader_unreadable )); then state=uncertain
  elif [[ "$leader_alive" == true ]]; then state=running
  elif [[ -z "$code" && "$wrapper_alive" == true ]]; then state=running
  elif [[ -n "$code" ]]; then
    if [[ "$(jq 'length' <<<"$live")" -gt 0 ]]; then state=lingering; else state=exited; fi
  else
    if [[ "$(jq 'length' <<<"$live")" -gt 0 ]]; then state=orphaned; else state=lost; fi
  fi

  # Unowned: processes in the job's cwd whose FULL command line equals one this job recorded,
  # that were never members. Reported, never signalled.
  unowned="$(for p in $(mae_own_pids_in "$cwd"); do
      [[ "$p" == "$$" || "$p" == "$PPID" ]] && continue
      cl="$(mae_pid_cmdline "$p")"
      jq -e --arg cl "$cl" 'index($cl) != null' <<<"$want" >/dev/null || continue
      grep -q "\"pid\":$p," "$J/members.jsonl" 2>/dev/null && continue
      jq -cn --arg p "$p" --arg cl "$cl" '{pid: ($p|tonumber), argv: $cl}'
    done | jq -sc .)"

  # Progress.
  local now ob eb ab lastline prev pb pe pa pl lp src=""
  now="$(date +%s)"
  ob="$(stat -c %s "$J/out" 2>/dev/null || echo 0)"; eb="$(stat -c %s "$J/err" 2>/dev/null || echo 0)"
  ab=0; [[ -n "$also" ]] && ab="$(stat -c %s "$also" 2>/dev/null || echo 0)"
  lastline="$( { tail -n1 "$J/err" 2>/dev/null || true
                  if [[ -n "$also" ]]; then tail -n1 "$also" 2>/dev/null || true; fi; } | sha256sum | cut -c1-16)"
  prev="$(cat "$J/progress" 2>/dev/null || echo '{}')"
  IFS=$'\x1f' read -r pb pe pa pl lp < <(jq -r '[(.out_bytes // 0), (.err_bytes // 0), (.also_bytes // 0), (.last_line // ""),
      (.last_progress_at // "")] | map(tostring) | join("\u001f")' <<<"$prev" 2>/dev/null || printf '0\x1f0\x1f0\x1f\x1f\n')
  [[ -n "$lp" ]] || lp="${started:-$now}"
  if (( ob > pb )); then lp="$now"; src="stdout"
  elif (( eb > pe || ab > pa )) && [[ "$lastline" != "$pl" ]]; then lp="$now"; src="stderr/log"
  fi
  if [[ $peek -eq 0 ]]; then
    jq -cn --argjson ob "$ob" --argjson eb "$eb" --argjson ab "$ab" --arg ll "$lastline" --argjson lp "$lp" \
      '{out_bytes: $ob, err_bytes: $eb, also_bytes: $ab, last_line: $ll, last_progress_at: $lp}' \
      | mae_atomic_write "$J/progress"
  fi
  local elapsed
  elapsed=$(( now - ${started:-$now} ))
  jq -cn --arg j "$job" --arg state "$state" --arg code "$code" --argjson el "$elapsed" \
    --argjson lp "$lp" --arg src "$src" --argjson live "$live" --argjson un "$unowned" \
    --argjson la "$leader_alive" \
    '{job_id: $j, state: $state, code: (if $code == "" then null else $code end), leader_alive: $la, elapsed: $el,
      last_progress_at: ($lp | todate), idle_s: (now - $lp | floor),
      progress_source: (if $src == "" then null else $src end),
      live_members: $live, unowned: $un}'
}

if [[ $peek -eq 1 ]]; then snapshot; exit 0; fi
deadline=$(( $(date +%s) + max ))
# --until-done: no deadline unless --max was given.
[[ $until -eq 1 && $max_set -eq 0 ]] && deadline=""
while :; do
  out="$(snapshot)"
  st="$(jq -r .state <<<"$out")"
  # Keep blocking while the leader lives, even when the state is uncertain (it is not terminated).
  if [[ "$st" == uncertain && "$(jq -r '.leader_alive // false' <<<"$out")" == true ]]; then st=running; fi
  if [[ "$st" != running ]]; then printf '%s\n' "$out"; exit 0; fi
  if [[ -n "$deadline" && $(date +%s) -ge $deadline ]]; then
    printf '%s\n' "$out"
    if [[ $until -eq 1 ]]; then exit 3; fi   # still waiting: not a final state
    exit 0
  fi
  sleep 2
done
