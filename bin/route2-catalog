#!/usr/bin/env bash
# route2-catalog — the live model catalog (docs/catalog.md).
#
#   route2-catalog refresh [--fixtures DIR] [--out FILE]
#       Read every source without a model turn and write .route2/catalog.json (or FILE):
#       codex `codex debug models` (fallback: $CODEX_HOME/models_cache.json, then
#       `codex debug models --bundled`), agy `agy models`, cursor `agent --list-models`.
#       --fixtures DIR reads DIR/codex-models.json, DIR/agy-models.txt, DIR/cursor-models.txt
#       instead (a missing file is an acquisition failure), and DIR/codex-cache.json for the
#       fallback path (tests).
#   route2-catalog candidates <slot> <transport> [--catalog FILE]
#       The slot's candidates on that transport, newest first: [{version, slugs: {effort: slug}}].
#   route2-catalog compare <v1> <v2>      → -1 | 0 | 1  (integer segments, missing = 0)
#   route2-catalog pick <slot> <transport> [--effort E] [--pin VERSION | --pin-slug SLUG]
#                       [--scope JSON] [--catalog FILE] [--probes FILE]
#       Walk the slot's candidates newest first, skipping versions with a fresh denial for this
#       scope: → {action: "use"|"probe", version, slug} or {action: "none", reason, previous}.
#   route2-catalog record-probe --gen N <transport> <slug> ok|denied --scope JSON [--detail TEXT]
#   route2-catalog record-resolved --gen N <slot> <transport> <version>
#   route2-catalog native-id <slot> <version>
#       the full Claude Code model id a canonical pin reaches native through (opus 5 → claude-opus-5,
#       opus 5.5 → claude-opus-5-5); the pin holds only if a probe of that id returns exactly it
#
# Probe records (.route2/model-probes.json) are keyed "<transport>:<slug>" and scoped: a record
# counts only when its scope object equals the caller's (CLI version, account identity, config
# mode, host, and the session key when an account is unknown). Positive: fresh < 7 days;
# negative (denied): fresh < 24 hours.
#
# Slots and their lines: opus fable sonnet haiku (Claude: agy, cursor; native has no list),
# astra sol luna terra (codex), gemini (agy), grok (cursor).
set -euo pipefail
. "$(dirname "$(readlink -f "$0")")/_lib.sh"

# shellcheck disable=SC2016  # jq programs, not shell expansions
# jq library: version parsing, comparison and the line patterns. Shared by every subcommand.
JQ_LIB='
def vparse: split("[.-]"; null) | map(tonumber);
def vcmp($a; $b):
  ([$a, $b] | map(length) | max) as $n
  | [range(0; $n)] | map(($a[.] // 0) as $x | ($b[.] // 0) as $y
      | if $x < $y then -1 elif $x > $y then 1 else 0 end)
  | (map(select(. != 0)) | first) // 0;
def efforts_re: "(low|medium|high|xhigh|max)";
# One catalog entry → {slot, version, effort, fast} or null. Anything else is "unmatched".
def classify($transport):
  . as $s
  | if $transport == "codex" then
      (capture("^gpt-(?<v>[0-9]+(\\.[0-9]+)*)-(?<line>astra|sol|luna|terra)$") // null)
      | if . then {slot: .line, version: (.v | vparse), effort: null, fast: false} else null end
    elif $transport == "agy" then
      ( (capture("^gemini-(?<v>[0-9]+(\\.[0-9]+)*)-flash(-(?<e>low|medium|high))?$")
          | {slot: "gemini", version: (.v | vparse), effort: .e, fast: false})
        // (capture("^claude-(?<line>opus|sonnet|fable|haiku)-(?<v>[0-9]+(-[0-9]+)*)-(?<e>low|medium|high|xhigh|max)$")
          | {slot: .line, version: (.v | vparse), effort: .e, fast: false})
        // null )
    elif $transport == "cursor" then
      ( (capture("^grok-(?<v>[0-9]+(\\.[0-9]+)*)(-(?<e>low|medium|high|xhigh|max))?(?<f>-fast)?$")
          | {slot: "grok", version: (.v | vparse), effort: .e, fast: (.f != null)})
        // (capture("^claude-(?<line>opus|sonnet|fable|haiku)-(?<v>[0-9]+(-[0-9]+)*)-(?<e>low|medium|high|xhigh|max)(?<f>-fast)?$")
          | {slot: .line, version: (.v | vparse), effort: .e, fast: (.f != null)})
        // null )
    else null end;
# Build the per-slot candidate lists for one transport from a list of {slug, efforts?}.
def lines_of($transport):
  map(. as $e | ($e.slug | classify($transport)) as $c
      | if $c == null then {unmatched: $e.slug}
        else $c + {slug: $e.slug, catalog_efforts: ($e.efforts // null)} end)
  | { unmatched: [ .[] | select(.unmatched) | .unmatched ],
      slots: ( [ .[] | select(.slot) ] | group_by(.slot)
               | map({ key: .[0].slot,
                       value: ( group_by(.version | map(tostring) | join("."))
                                | map({ version: .[0].version,
                                        slugs: ( map(select(.fast | not))
                                                 | map({key: (.effort // "default"), value: .slug}) | from_entries ),
                                        fast_slugs: ( map(select(.fast))
                                                 | map({key: (.effort // "default"), value: .slug}) | from_entries ),
                                        catalog_efforts: (map(.catalog_efforts) | map(select(. != null)) | first // null) })
                              ) })
               | from_entries ) };
'
# shellcheck disable=SC2016
# Newest first, by vcmp (jq's own array sort would put [6] before [6,0], which vcmp calls equal).
JQ_SORT='
def vsort: . as $in | reduce range(0; length) as $i ([];
    . as $acc | ($in[$i]) as $x
    | ([ $acc | to_entries[] | select(vcmp(.value.version; $x.version) < 0) | .key ] | first) as $pos
    | if $pos == null then $acc + [$x] else $acc[0:$pos] + [$x] + $acc[$pos:] end);
'

SD="$(r2_state_dir 2>/dev/null || echo .route2)"
sub="${1:-}"; shift || true

case "$sub" in
  native-id)
    case "${1:-}" in opus|fable|sonnet|haiku) ;; *) r2_die "native-id: a Claude slot (opus, fable, sonnet, haiku)" ;; esac
    [[ "${2:-}" =~ ^[0-9]+(\.[0-9]+)*$ ]] || r2_die "native-id: a version such as 5 or 5.5"
    printf 'claude-%s-%s\n' "$1" "${2//./-}" ;;

  compare)
    jq -rn --arg a "$1" --arg b "$2" "$JQ_LIB"' vcmp($a | vparse; $b | vparse)' ;;

  candidates)
    slot="$1" transport="$2"; shift 2
    cat_file="$SD/catalog.json"
    [[ "${1:-}" == "--catalog" ]] && cat_file="$2"
    jq -c --arg s "$slot" --arg t "$transport" '.transports[$t].slots[$s] // []' "$cat_file" ;;

  refresh)
    fixtures="" out="$SD/catalog.json"
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --fixtures) fixtures="$2"; shift 2 ;;
        --out) out="$2"; shift 2 ;;
        *) r2_die "route2-catalog refresh: unknown option $1" ;;
      esac
    done
    mkdir -p "$(dirname "$out")"
    tmpd="$(mktemp -d)"; trap 'rm -rf "$tmpd"' EXIT

    # --- codex --------------------------------------------------------------------------------
    codex_mode="" codex_err=""
    if [[ -n "$fixtures" ]]; then
      if [[ -f "$fixtures/codex-models.json" ]]; then cp "$fixtures/codex-models.json" "$tmpd/codex.json"; codex_mode=live
      elif [[ -f "$fixtures/codex-cache.json" ]]; then cp "$fixtures/codex-cache.json" "$tmpd/codex.json"; codex_mode=cache
      elif [[ -f "$fixtures/codex-bundled.json" ]]; then cp "$fixtures/codex-bundled.json" "$tmpd/codex.json"; codex_mode=bundled
      else codex_err="fixture missing"; fi
    elif command -v codex >/dev/null 2>&1; then
      if "$R2_BIN/route2-env" -- codex debug models > "$tmpd/codex.json" 2>"$tmpd/codex.err"; then codex_mode=live
      elif [[ -f "${CODEX_HOME:-$HOME/.codex}/models_cache.json" ]]; then
        cp "${CODEX_HOME:-$HOME/.codex}/models_cache.json" "$tmpd/codex.json"; codex_mode=cache
      elif "$R2_BIN/route2-env" -- codex debug models --bundled > "$tmpd/codex.json" 2>>"$tmpd/codex.err"; then codex_mode=bundled
      else codex_err="$(head -c 300 "$tmpd/codex.err")"; fi
    else codex_err="codex not installed"; fi
    codex_list='null' codex_meta='{}'
    if [[ -n "$codex_mode" ]]; then
      if codex_list="$(jq -c '[ .models[] | select((.visibility // "list") == "list")
                                | {slug, efforts: [ .supported_reasoning_levels[]?.effort ],
                                   default_effort: .default_reasoning_level} ]' "$tmpd/codex.json" 2>/dev/null)"; then
        codex_meta="$(jq -c --arg m "$codex_mode" '{mode: $m, client_version: (.client_version // null),
                        fetched_at: (.fetched_at // null), identity: (.identity // null)}' "$tmpd/codex.json")"
        # `codex debug models` carries no account identity; the cache it refreshes does.
        cache="${CODEX_HOME:-$HOME/.codex}/models_cache.json"
        [[ -n "$fixtures" ]] && cache="$fixtures/codex-cache.json"
        if [[ "$codex_mode" == live && -f "$cache" ]]; then
          codex_meta="$(jq -c --slurpfile c "$cache" '. + {identity: ($c[0].identity // null),
                          client_version: ($c[0].client_version // null), fetched_at: ($c[0].fetched_at // null)}' <<<"$codex_meta")"
        fi
        if [[ "$codex_mode" == cache ]]; then
          fa="$(jq -r '.fetched_at // empty' "$tmpd/codex.json")"
          cv="$(jq -r '.client_version // empty' "$tmpd/codex.json")"
          now_cv="$(codex --version 2>/dev/null | awk '{print $NF}' || true)"
          stale=false
          if [[ -z "$fa" ]] || (( $(date +%s) - $(date -d "$fa" +%s 2>/dev/null || echo 0) > 7*86400 )); then stale=true; fi
          [[ -n "$now_cv" && "$cv" != "$now_cv" ]] && stale=true
          codex_meta="$(jq -c --argjson s "$stale" '. + {stale: $s}' <<<"$codex_meta")"
        fi
      else
        codex_list='null'; codex_err="malformed codex catalog"
      fi
    fi

    # --- agy and cursor: "slug<TAB or ' - '>label" lines, banners skipped ---------------------
    read_list() {  # $1 = name, $2 = fixture file, $3… = command
      local name="$1" fx="$2"; shift 2
      if [[ -n "$fixtures" ]]; then
        [[ -f "$fixtures/$fx" ]] || return 1
        cat "$fixtures/$fx"
      else
        command -v "$1" >/dev/null 2>&1 || return 1
        "$R2_BIN/route2-env" -- "$@" 2>/dev/null || return 1
      fi > "$tmpd/$name.txt"
      # A model line starts with a lower-case slug token followed by a tab or " - ".
      grep -E '^[a-z0-9][a-z0-9.\-]*(	| - )' "$tmpd/$name.txt" \
        | sed -E 's/^([a-z0-9][a-z0-9.\-]*)(	| - ).*/\1/' | jq -R '{slug: .}' | jq -sc .
    }
    agy_list='null' agy_err="" cursor_list='null' cursor_err=""
    agy_list="$(read_list agy agy-models.txt agy models)" || { agy_list='null'; agy_err="agy models failed"; }
    [[ "$agy_list" == "[]" ]] && { agy_list='null'; agy_err="agy models: no model lines"; }
    cursor_list="$(read_list cursor cursor-models.txt agent --list-models)" || { cursor_list='null'; cursor_err="agent --list-models failed"; }
    [[ "$cursor_list" == "[]" ]] && { cursor_list='null'; cursor_err="agent --list-models: no model lines"; }

    prev='{}'
    [[ -f "$out" ]] && prev="$(jq -c '.resolved // {}' "$out" 2>/dev/null || echo '{}')"

    jq -n --argjson cx "$codex_list" --argjson cm "$codex_meta" --arg ce "$codex_err" \
          --argjson ag "$agy_list" --arg ae "$agy_err" \
          --argjson cu "$cursor_list" --arg cue "$cursor_err" \
          --argjson prev "$prev" --arg at "$(r2_now)" \
      "$JQ_LIB$JQ_SORT"'
      def build($list; $t):
        if $list == null then null
        else ($list | map({slug, efforts}) | lines_of($t)) as $l
             | {unmatched: $l.unmatched,
                slots: ($l.slots | map_values(map(del(.catalog_efforts)) | vsort))}
        end;
      { generated_at: $at,
        sources: { codex: ($cm + {error: (if $ce == "" then null else $ce end)}),
                   agy: {error: (if $ae == "" then null else $ae end)},
                   cursor: {error: (if $cue == "" then null else $cue end)} },
        transports: { codex: build($cx; "codex"), agy: build($ag; "agy"), cursor: build($cu; "cursor") },
        codex_efforts: (if $cx == null then null else ($cx | map({key: .slug, value: {efforts, default_effort}}) | from_entries) end),
        previous: $prev,
        resolved: {} }' | r2_atomic_write "$out"
    jq -c '{generated_at, sources, slots: (.transports | map_values(if . == null then null else (.slots | map_values(map(.version | map(tostring) | join(".")))) end))}' "$out" ;;

  pick)
    slot="$1" transport="$2"; shift 2
    effort="" pin="" pin_slug="" scope='{}' cat_file="$SD/catalog.json" probes="$SD/model-probes.json"
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --effort) effort="$2"; shift 2 ;;
        --pin) pin="$2"; shift 2 ;;
        --pin-slug) pin_slug="$2"; shift 2 ;;
        --scope) scope="$2"; shift 2 ;;
        --catalog) cat_file="$2"; shift 2 ;;
        --probes) probes="$2"; shift 2 ;;
        *) r2_die "route2-catalog pick: unknown option $1" ;;
      esac
    done
    [[ -f "$probes" ]] || probes=/dev/null
    jq -c --arg slot "$slot" --arg t "$transport" --arg e "$effort" --arg pin "$pin" --arg ps "$pin_slug" \
       --argjson scope "$scope" --slurpfile pr <(cat "$probes" 2>/dev/null || echo '{}') \
       --argjson now "$(date +%s)" "$JQ_LIB"'
      ($pr[0] // {}) as $probes
      | (.transports[$t]) as $tr
      | if $tr == null then {action: "none", reason: "transport \($t): catalog unavailable (\(.sources[$t].error // "unknown"))"}
        else
        ($tr.slots[$slot] // []) as $cands
        | (.previous[$slot][$t] // null) as $prev
        | def slug_of($c): if $e != "" then ($c.slugs[$e] // $c.slugs["default"] // null)
                           else ($c.slugs["default"] // ($c.slugs | to_entries | first | .value) // null) end;
          def rec($slug): $probes[$t + ":" + $slug] // null;
          def fresh($r): $r != null and $r.scope == $scope
             and (($now - ($r.at_epoch // 0)) < (if $r.result == "ok" then 7*86400 else 86400 end));
        # A slug excluded from automatic resolution may be pinned only if it still belongs to the
        # line of the slot (gpt-<v>-sol-preview for sol, claude-opus-… for opus) — never another model.
        def line_re: {astra: "^gpt-[0-9.]+-astra(-|$)", sol: "^gpt-[0-9.]+-sol(-|$)", luna: "^gpt-[0-9.]+-luna(-|$)",
                      terra: "^gpt-[0-9.]+-terra(-|$)", gemini: "^gemini-[0-9.]+-flash(-|$)", grok: "^grok-[0-9.]+(-|$)",
                      opus: "^claude-opus-[0-9]", fable: "^claude-fable-[0-9]", sonnet: "^claude-sonnet-[0-9]",
                      haiku: "^claude-haiku-[0-9]"}[$slot] // "^$";
        ((($tr.unmatched // []) | index($ps)) as $i | if $i != null and ($ps | test(line_re)) then $i else null end) as $excluded_hit
        | ( if $ps != "" and $excluded_hit != null and ([ $cands[] | select(.slugs | to_entries | any(.value == $ps)) ] | length) == 0 then
              # An exact pin may name a slug excluded from automatic resolution (preview, dated):
              # its identity is the slug itself (a tag), it never matches another transport.
              [ {version: [], slugs: {}, forced_slug: $ps, excluded: true} ]
            elif $ps != "" then [ $cands[] | select(.slugs | to_entries | any(.value == $ps)) | . + {forced_slug: $ps} ]
          elif $pin != "" then [ $cands[] | select(vcmp(.version; $pin | vparse) == 0) ]
          else $cands end ) as $pool
        | if ($pool | length) == 0 then
            {action: "none",
             reason: (if $ps != "" and (($tr.unmatched // []) | index($ps)) != null and ($ps | test(line_re) | not)
                        then "pinned slug \($ps) is not a \($slot) model"
                      elif $ps != "" then "pinned slug \($ps) not in the \($t) catalog"
                      elif $pin != "" then "pinned version \($pin) not in the \($t) catalog"
                      else "line \($slot) has no candidates on \($t)" end),
             previous: $prev}
          else
            [ $pool[] | (.forced_slug // slug_of(.)) as $s | select($s != null)
              | {version: (.version | map(tostring) | join(".")), slug: $s, rec: rec($s),
                 excluded: (.excluded // false)} ] as $list
            | ([ $list[] | select((fresh(.rec) and .rec.result == "denied") | not) ] | first) as $c
            | if ($list | length) == 0 then
                {action: "none", reason: "no \($slot) slug on \($t) for effort \($e)", previous: $prev}
              elif $c == null then
                {action: "none", reason: "every candidate is denied for this account", previous: $prev,
                 denied: [ $list[] | .slug ]}
              elif $c.excluded then {action: (if fresh($c.rec) and $c.rec.result == "ok" then "use" else "probe" end),
                 version: null, slug: $c.slug, identity: {line: $slot, tag: $c.slug}, excluded: true,
                 note: "exact pin of a slug excluded from automatic resolution; it matches no other transport"}
              elif fresh($c.rec) and $c.rec.result == "ok" then {action: "use", version: $c.version, slug: $c.slug,
                 skipped: [ $list[] | select(fresh(.rec) and .rec.result == "denied") | .slug ]}
              else {action: "probe", version: $c.version, slug: $c.slug,
                 skipped: [ $list[] | select(fresh(.rec) and .rec.result == "denied") | .slug ]} end
          end
        end' "$cat_file" ;;

  record-probe|__record-probe)
    if [[ "$sub" == record-probe ]]; then
      [[ "${1:-}" == --gen ]] || r2_die "record-probe needs --gen N first"
      gen="$2"; shift 2
      exec "$R2_BIN/route2-lock" exec --gen "$gen" -- "$0" __record-probe "$@"
    fi
    transport="$1" slug="$2" result="$3"; shift 3
    scope='{}' detail=""
    while [[ $# -gt 0 ]]; do
      case "$1" in --scope) scope="$2"; shift 2 ;; --detail) detail="$2"; shift 2 ;; *) r2_die "unknown option $1" ;; esac
    done
    [[ "$result" == ok || "$result" == denied ]] || r2_die "record-probe: result is ok or denied"
    pf="$SD/model-probes.json"
    { cat "$pf" 2>/dev/null || echo '{}'; } | jq --arg k "$transport:$slug" --arg r "$result" --argjson s "$scope" \
        --arg d "$detail" --arg at "$(r2_now)" --argjson ep "$(date +%s)" \
        '.[$k] = {result: $r, scope: $s, at: $at, at_epoch: $ep, detail: (if $d == "" then null else $d end)}' \
      | r2_atomic_write "$pf"
    jq -cn --arg k "$transport:$slug" --arg r "$result" '{recorded: $k, result: $r}' ;;

  record-resolved|__record-resolved)
    if [[ "$sub" == record-resolved ]]; then
      [[ "${1:-}" == --gen ]] || r2_die "record-resolved needs --gen N first"
      gen="$2"; shift 2
      exec "$R2_BIN/route2-lock" exec --gen "$gen" -- "$0" __record-resolved "$@"
    fi
    slot="$1" transport="$2" version="$3"
    jq --arg s "$slot" --arg t "$transport" --arg v "$version" '.resolved[$s][$t] = $v' "$SD/catalog.json" \
      | r2_atomic_write "$SD/catalog.json"
    jq -cn --arg s "$slot" --arg t "$transport" --arg v "$version" '{resolved: $s, transport: $t, version: $v}' ;;

  *) r2_die "usage: route2-catalog refresh|candidates|compare|pick|record-probe|record-resolved …" ;;
esac
