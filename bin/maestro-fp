#!/usr/bin/env bash
# maestro-fp — read-only proof for external read-only roles (docs/hosts.md, "Read-only proof").
#
#   maestro-fp snapshot [--repo DIR] > before.json
#   maestro-fp compare before.json [--repo DIR]     → {result: same|changed, diffs: [...]}; exit 0|1
#
# Covers the checkout (branch, HEAD, staged and unstaged content, untracked paths and contents)
# and the durable .maestro/ files that info/exclude hides from git:
#   protected inputs  everything under .maestro/ except the excluded paths below — hashed before
#                     and after, the director does not write them during a read-only call;
#   bookkeeping       CHECKPOINT.md, ledger.jsonl, pending-decision.md, lock, tasks/*/entry.json
#                     — legitimately written during the call through maestro-state / maestro-lock —
#                     and every job's immutable meta.json, cmd and cwd (audited by maestro-run at
#                     launch, so a job launched during the call verifies too); each must equal its
#                     last audit entry, and the audit's prefix must be intact.
# Excluded: the rest of jobs/ (job-owned outputs written while the call runs), tmp/, evidence/,
# worktrees/, lock.flock, lock.heartbeat, lock.gen, audit.jsonl (checked by prefix).
# Change detection in the checkout and .maestro/, not proof against writes elsewhere.
set -euo pipefail
. "$(dirname "$(readlink -f "$0")")/_lib.sh"

sub="${1:-}"; shift || true
before=""
[[ "$sub" == compare ]] && { before="${1:-}"; shift || true; }
repo="."
[[ "${1:-}" == "--repo" ]] && repo="$2"
cd "$repo"
SD="$(mae_state_dir)"

is_bookkeeping() {
  case "$1" in
    CHECKPOINT.md|ledger.jsonl|pending-decision.md|lock|tasks/*/entry.json) return 0 ;;
    jobs/*/meta.json|jobs/*/cmd|jobs/*/cwd) return 0 ;;   # immutable job records, audited at launch
    *) return 1 ;;
  esac
}

snapshot() {
  local branch head dh dc untracked prot book al ap
  branch="$(git symbolic-ref -q --short HEAD || echo DETACHED)"
  head="$(git rev-parse -q --verify HEAD || echo none)"
  dh="$(git diff --binary HEAD 2>/dev/null | sha256sum | cut -c1-64)"
  dc="$(git diff --cached --binary 2>/dev/null | sha256sum | cut -c1-64)"
  untracked="$(git ls-files --others --exclude-standard -z \
      | while IFS= read -r -d '' f; do jq -cn --arg p "$f" --arg s "$(mae_sha256_file "$f")" '{path: $p, sha: $s}'; done \
      | jq -sc 'sort_by(.path)')"
  prot='[]' book='[]'
  if [[ -d "$SD" ]]; then
    prot="$(cd "$SD" && find . -type f \
        -not -path './jobs/*' -not -path './tmp/*' -not -path './evidence/*' -not -path './worktrees/*' \
        -not -name lock.flock -not -name lock.heartbeat -not -name lock.gen -not -name audit.jsonl \
        -printf '%P\n' | sort | while IFS= read -r f; do
          is_bookkeeping "$f" && continue
          jq -cn --arg p "$f" --arg s "$(mae_sha256_file "$f")" '{path: $p, sha: $s}'
        done | jq -sc .)"
    book="$(cd "$SD" && find . -type f \( -path ./CHECKPOINT.md -o -path ./ledger.jsonl -o -path ./pending-decision.md \
        -o -path ./lock -o -path './tasks/*/entry.json' -o -path './jobs/*/meta.json' -o -path './jobs/*/cmd' \
        -o -path './jobs/*/cwd' \) -printf '%P\n' | sort \
        | while IFS= read -r f; do jq -cn --arg p "$f" --arg s "$(mae_sha256_file "$f")" '{path: $p, sha: $s}'; done | jq -sc .)"
  fi
  al=0; ap="$(printf '' | sha256sum | cut -c1-64)"
  if [[ -f "$SD/audit.jsonl" ]]; then
    al="$(wc -l < "$SD/audit.jsonl")"; ap="$(sha256sum < "$SD/audit.jsonl" | cut -c1-64)"
  fi
  jq -cn --arg b "$branch" --arg h "$head" --arg dh "$dh" --arg dc "$dc" --argjson u "$untracked" \
    --argjson p "$prot" --argjson k "$book" --argjson al "$al" --arg ap "$ap" \
    '{branch: $b, head: $h, diff_head: $dh, diff_cached: $dc, untracked: $u,
      protected: $p, bookkeeping: $k, audit_lines: $al, audit_sha: $ap}'
}

case "$sub" in
  snapshot) snapshot ;;
  compare)
    [[ -f "$before" ]] || mae_die "usage: maestro-fp compare before.json [--repo DIR]"
    now="$(snapshot)"
    diffs="$(jq -c --slurpfile b "$before" '
      $b[0] as $b | . as $n
      | [ (if $b.branch != $n.branch then "branch" else empty end),
          (if $b.head != $n.head then "HEAD" else empty end),
          (if $b.diff_head != $n.diff_head then "tracked changes (git diff HEAD)" else empty end),
          (if $b.diff_cached != $n.diff_cached then "staged changes" else empty end),
          (if $b.untracked != $n.untracked then "untracked files" else empty end),
          (if $b.protected != $n.protected then "protected .maestro inputs" else empty end) ]' <<<"$now")"
    # Bookkeeping: each file must equal its last audit entry; the audit's old prefix must be intact.
    al="$(jq -r .audit_lines "$before")"
    if [[ "$al" -gt 0 ]]; then
      if [[ ! -f "$SD/audit.jsonl" ]] || [[ "$(head -n "$al" "$SD/audit.jsonl" | sha256sum | cut -c1-64)" != "$(jq -r .audit_sha "$before")" ]]; then
        diffs="$(jq -c '. + ["audit.jsonl prefix"]' <<<"$diffs")"
      fi
    fi
    while IFS= read -r f; do
      [[ -n "$f" ]] || continue
      mae_audit_verify "$SD" "$f" 2>/dev/null || diffs="$(jq -c --arg f "$f" '. + ["bookkeeping " + $f + " not as audited"]' <<<"$diffs")"
    done < <(jq -r '.bookkeeping[].path' <<<"$now"; jq -r '.bookkeeping[].path' "$before")
    diffs="$(jq -c 'unique' <<<"$diffs")"
    if [[ "$diffs" == "[]" ]]; then jq -cn '{result: "same", diffs: []}'
    else jq -cn --argjson d "$diffs" '{result: "changed", diffs: $d}'; exit 1; fi ;;
  *) mae_die "usage: maestro-fp snapshot|compare …" ;;
esac
