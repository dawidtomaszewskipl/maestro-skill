#!/usr/bin/env bash
# maestro-lock — one director per checkout, fenced by a secret per owner (docs/hosts.md, "Lock").
#
#   maestro-lock acquire --run R --token T --host H [--session S] [--pid P --starttime ST]
#                       [--resume] [--fence F]
#   maestro-lock check     --gen F
#   maestro-lock exec      --gen F -- <command…>   run <command> inside the fence (flock held)
#   maestro-lock heartbeat --gen F
#   maestro-lock release   --token T --gen F
#   maestro-lock show
#
# acquire prints {result, generation, fence}. The FENCE is "<generation>.<secret>": the secret is
# generated at acquire and returned only to the acquirer; the lock stores only its sha256. Every
# fenced call takes it as --gen, so the generation alone (readable in the lock file) never grants
# a mutation, and two contenders that both know the run's token still get different fences.
# Re-entry: `acquire --fence F` with the current fence returns it unchanged. A live owner keeps
# the lock against everyone else, its own run's --resume included.
#
# The lock record (.maestro/lock) is {run_id, token, generation, fence_sha, host, session_key,
# liveness}; liveness = {kind: "pid", pid, starttime} or {kind: "heartbeat"} (.maestro/lock.heartbeat
# mtime, touched by every fenced call). Every read-modify-write happens under `flock -w 30` on
# .maestro/lock.flock; exec uses `flock -o`, so the command and its children hold no lock fd.
#
# Exit codes: 0 ok · 3 held by a live owner · 4 not the current fence (superseded) · 5 blocked
# (jobs of the previous owner alive) or tampered · 2 usage or I/O error.
set -euo pipefail
. "$(dirname "$(readlink -f "$0")")/_lib.sh"

SD="$(mae_state_dir)"
LOCK="$SD/lock"
LF="$SD/lock.flock"
HB="$SD/lock.heartbeat"
WAIT_S="${MAESTRO_FLOCK_WAIT:-30}"
WINDOW="${MAESTRO_HEARTBEAT_WINDOW:-1800}"

mkdir -p "$SD"
: >> "$LF"

cmd="${1:-}"; shift || true

declare -A opt=()
rest=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --) shift; rest=("$@"); break ;;
    --resume) opt[resume]=1; shift ;;
    --*) k="${1#--}"; opt[${k//-/_}]="${2:-}"; shift 2 ;;
    *) rest+=("$1"); shift ;;
  esac
done

read_lock() { if [[ -f "$LOCK" ]]; then cat "$LOCK"; else echo '{}'; fi; }
sha() { printf '%s' "$1" | sha256sum | cut -c1-64; }

owner_alive() {
  local rec="$1" kind pid st age
  kind="$(jq -r '.liveness.kind // empty' <<<"$rec")"
  case "$kind" in
    pid)
      pid="$(jq -r '.liveness.pid' <<<"$rec")"; st="$(jq -r '.liveness.starttime' <<<"$rec")"
      if mae_pid_same "$pid" "$st"; then echo true; else echo false; fi ;;
    heartbeat)
      if [[ -f "$HB" ]]; then
        age=$(( $(date +%s) - $(stat -c %Y "$HB") ))
        if (( age < WINDOW )); then echo true; else echo false; fi
      else echo false; fi ;;
    *) echo false ;;
  esac
}

live_jobs_of_run() {
  local run="$1" d st
  for d in "$SD"/jobs/*/; do
    [[ -f "$d/meta.json" ]] || continue
    [[ "$(jq -r '.run_id // empty' "$d/meta.json")" == "$run" ]] || continue
    st="$("$MAESTRO_BIN/maestro-wait" "$(basename "$d")" --peek | jq -r '.state')"
    case "$st" in running|lingering|orphaned|uncertain) printf '%s\n' "$(basename "$d")" ;; esac
  done
}

write_lock() {
  local gen
  gen="$(jq -r '.generation' <<<"$1")"
  mae_atomic_write "$LOCK" <<<"$1"
  mae_audit_record "$SD" lock "$gen"
}

with_flock() {
  local fd rc=0
  exec {fd}>>"$LF"
  if ! flock -w "$WAIT_S" "$fd"; then
    exec {fd}>&-; mae_die "lock: could not take $LF within ${WAIT_S}s"
  fi
  "$@" || rc=$?
  exec {fd}>&-
  return "$rc"
}

# The fence the caller presents must be the current one: generation part equal, secret hash equal.
fence_ok() {  # $1 = lock record, $2 = presented fence
  local rec="$1" f="$2" gen
  [[ -n "$f" && "$f" == *.* ]] || return 1
  gen="$(jq -r '.generation // empty' <<<"$rec")"
  [[ "${f%%.*}" == "$gen" && "$(sha "$f")" == "$(jq -r '.fence_sha // empty' <<<"$rec")" ]]
}

do_acquire() {
  local rec cur_run cur_token gen alive live_jobs liveness new secret fence
  [[ -n "${opt[run]:-}" && -n "${opt[token]:-}" && -n "${opt[host]:-}" ]] \
    || mae_die "acquire needs --run, --token and --host"
  rec="$(read_lock)"
  if [[ -f "$LOCK" ]] && ! mae_audit_verify "$SD" lock; then
    jq -cn '{result: "tampered", file: "lock"}'; return 5
  fi
  cur_run="$(jq -r '.run_id // empty' <<<"$rec")"
  cur_token="$(jq -r '.token // empty' <<<"$rec")"
  gen="$(jq -r '.generation // 0' <<<"$rec")"
  if [[ -f "$SD/lock.gen" ]] && (( $(cat "$SD/lock.gen") > gen )); then gen="$(cat "$SD/lock.gen")"; fi
  if [[ -n "${opt[pid]:-}" ]]; then
    liveness="$(jq -cn --arg p "${opt[pid]}" --arg s "${opt[starttime]:-}" '{kind:"pid", pid:($p|tonumber), starttime:$s}')"
  else
    liveness='{"kind":"heartbeat"}'
  fi

  if [[ -n "$cur_run" ]]; then
    # Re-entry: only the holder of the current fence.
    if [[ -n "${opt[fence]:-}" ]] && fence_ok "$rec" "${opt[fence]}"; then
      [[ -f "$HB" ]] && touch "$HB"
      jq -cn --argjson g "$(jq '.generation' <<<"$rec")" --arg f "${opt[fence]}" \
        '{result: "reentrant", generation: $g, fence: $f}'
      return 0
    fi
    alive="$(owner_alive "$rec")"
    if [[ "$alive" == true ]]; then
      jq -cn --argjson owner "$(jq -c 'del(.fence_sha)' <<<"$rec")" '{result: "held", owner: $owner}'; return 3
    fi
    if [[ -n "${opt[resume]:-}" ]]; then
      [[ "$cur_run" == "${opt[run]}" && "$cur_token" == "${opt[token]}" ]] || {
        jq -cn --argjson owner "$(jq -c 'del(.fence_sha)' <<<"$rec")" \
          '{result: "held", reason: "resume of a different run or token", owner: $owner}'
        return 3; }
    else
      live_jobs="$(live_jobs_of_run "$cur_run")"
      if [[ -n "$live_jobs" ]]; then
        jq -cn --arg jobs "$live_jobs" --argjson owner "$(jq -c 'del(.fence_sha)' <<<"$rec")" \
          '{result: "blocked", jobs: ($jobs | split("\n") | map(select(. != ""))), owner: $owner}'
        return 5
      fi
    fi
  fi

  secret="$(head -c 16 /dev/urandom | od -An -tx1 | tr -d ' \n')"
  fence="$((gen + 1)).$secret"
  new="$(jq -cn --arg run "${opt[run]}" --arg token "${opt[token]}" --argjson g "$((gen + 1))" \
    --arg fs "$(sha "$fence")" --arg host "${opt[host]}" --arg s "${opt[session]:-}" \
    --argjson l "$liveness" --arg at "$(mae_now)" \
    '{run_id: $run, token: $token, generation: $g, fence_sha: $fs, host: $host,
      session_key: (if $s == "" then null else $s end), liveness: $l, acquired_at: $at}')"
  write_lock "$new"
  printf '%s' "$((gen + 1))" > "$SD/lock.gen"
  # Publish liveness in the same flock section (a heartbeat owner is live from this instant).
  if [[ "$(jq -r '.kind' <<<"$liveness")" == heartbeat ]]; then touch "$HB"; fi
  local adopted=""
  [[ -n "${opt[resume]:-}" ]] && adopted="$(live_jobs_of_run "${opt[run]}")"
  jq -cn --argjson g "$((gen + 1))" --arg f "$fence" --arg a "$adopted" \
    '{result: "acquired", generation: $g, fence: $f, adopted_jobs: ($a | split("\n") | map(select(. != "")))}'
}

check_fence_unlocked() {  # caller holds the flock
  local rec
  rec="$(read_lock)"
  if ! fence_ok "$rec" "${opt[gen]:-}"; then
    mae_warn "fence: the presented fence is not the current owner's — this director was superseded (or never held the lock)"
    return 4
  fi
  mae_audit_verify "$SD" lock || return 4
}

do_release() {
  local rec
  rec="$(read_lock)"
  [[ "$(jq -r '.token // empty' <<<"$rec")" == "${opt[token]:-}" ]] || { mae_warn "release: token mismatch"; return 4; }
  check_fence_unlocked || return 4
  rm -f "$LOCK" "$HB"
  mae_audit_record "$SD" lock "release"
  jq -cn '{result: "released"}'
}

do_heartbeat() { check_fence_unlocked || return 4; touch "$HB"; }

case "$cmd" in
  acquire)   with_flock do_acquire ;;
  check)     with_flock check_fence_unlocked && jq -cn --arg f "${opt[gen]}" '{result: "current", generation: ($f | split(".")[0] | tonumber)}' ;;
  heartbeat) with_flock do_heartbeat ;;
  release)   with_flock do_release ;;
  show)      read_lock | jq -c 'del(.fence_sha)' ;;
  exec)
    [[ ${#rest[@]} -gt 0 ]] || mae_die "exec needs -- <command…>"
    if mae_in_fence; then
      # Already inside a fenced section (a helper given --gen, called from a command that runs
      # under `maestro-lock exec`). The flock is held by the outer flock(1) process for as long as
      # it lives, so a nested exec runs the command directly — but only while that holder is
      # alive (a detached child that outlived the section holds nothing) and only for the current
      # fence (checked again here, under the holder's lock). Taking the flock again would deadlock.
      holder="${MAESTRO_FENCE_HOLDER:-}"
      if [[ -n "$holder" ]] && mae_pid_same "${holder%%:*}" "${holder#*:}" \
         && [[ "$(mae_pid_cmdline "${holder%%:*}")" == "flock "*" -o $LF "* ]]; then
        check_fence_unlocked || exit 4
        exec "${rest[@]}"
      fi
      mae_die "nested maestro-lock exec refused: the enclosing fenced section is gone"
    fi
    exec flock -w "$WAIT_S" -o "$LF" env MAESTRO_IN_FENCE=1 "$0" __exec_locked --gen "${opt[gen]:-}" -- "${rest[@]}" ;;
  __exec_locked)
    check_fence_unlocked || exit 4
    [[ -f "$HB" ]] && touch "$HB"
    # The parent is flock(1), which holds the lock until the command exits: nested calls check it.
    MAESTRO_FENCE_HOLDER="$PPID:$(mae_pid_starttime "$PPID")"; export MAESTRO_FENCE_HOLDER
    exec "${rest[@]}" ;;
  *) mae_die "usage: maestro-lock acquire|check|exec|heartbeat|release|show …" ;;
esac
