#!/usr/bin/env bash
# maestro-host — confirm that Claude Code runs the director (docs/hosts.md, "Detection").
#
# Prints one JSON line:
#   {host, interactive, session_key, host_pid, host_pid_starttime, director_family, evidence: [...]}
# host ∈ claude-code | unsupported | unknown.
#   claude-code  the nearest agent CLI above this shell is Claude Code and CLAUDECODE=1 is set
#   unsupported  the nearest agent CLI is another one (codex, agy, cursor-agent): maestro directs
#                only from Claude Code since 2.0.0 — those CLIs are workers
#   unknown      no agent CLI in the visible ancestry and the markers do not settle it
#
# Order: the NEAREST ancestor whose executable is a known agent CLI wins (outer CLIs' markers are
# inherited by children and are not a conflict). The marker of a CLI that is set but absent from
# the visible ancestry means a sandbox hid part of the chain: the ancestry is not trusted then.
# With no visible ancestry, CLAUDECODE alone (no other CLI's marker) gives claude-code.
#
# Env for tests: MAESTRO_PROC (fake /proc), MAESTRO_HOST_START_PID (first pid to inspect).
set -euo pipefail
. "$(dirname "$(readlink -f "$0")")/_lib.sh"

evidence=()
ev() { evidence+=("$1"); }

# --- classification of one process ---------------------------------------------------------------
cli_of_pid() {
  local pid="$1" exe argv0 argv1 b0 be
  exe="$(mae_pid_exe "$pid")"
  local -a argv=()
  if [[ -r "$(mae_proc)/$pid/cmdline" ]]; then
    mapfile -d '' -t argv < "$(mae_proc)/$pid/cmdline" || true
  fi
  argv0="${argv[0]:-}"; argv1="${argv[1]:-}"
  b0="${argv0##*/}"; be="${exe##*/}"
  if [[ "$be" == "codex" || "$b0" == "codex" ]]; then echo codex; return; fi
  if [[ "$exe" == */cursor-agent/* || "$argv1" == */cursor-agent/* \
        || "$b0" == "cursor-agent" || ( "$b0" == "agent" && "$be" == node* ) ]]; then
    echo cursor; return
  fi
  if [[ "$be" == "agy" || "$b0" == "agy" ]]; then echo agy; return; fi
  if [[ "$exe" == */claude/versions/* || "$b0" == "claude" ]]; then echo claude-code; return; fi
  echo ""
}

# Headless when Claude Code was started in print mode.
interactive_of_pid() {
  local a
  local -a argv=()
  mapfile -d '' -t argv < "$(mae_proc)/$1/cmdline" 2>/dev/null || true
  for a in "${argv[@]:1}"; do
    [[ "$a" == "-p" || "$a" == "--print" ]] && { echo false; return; }
  done
  echo true
}

marker_present() {
  case "$1" in
    claude-code) [[ "${CLAUDECODE:-}" == "1" ]] ;;
    codex)       [[ -n "${CODEX_THREAD_ID:-}" ]] ;;
    cursor)      [[ "${CURSOR_AGENT:-}" == "1" && -n "${CURSOR_CONVERSATION_ID:-}" ]] ;;
    agy)         [[ "${ANTIGRAVITY_AGENT:-}" == "1" && -n "${ANTIGRAVITY_CONVERSATION_ID:-}" ]] ;;
    *)           return 1 ;;
  esac
}

# --- walk the ancestry --------------------------------------------------------------------------
start="${MAESTRO_HOST_START_PID:-$PPID}"
host="" host_pid="" visible=false pid="$start" hops=0
declare -A seen=()
while [[ -n "$pid" && "$pid" -gt 1 && $hops -lt 64 ]]; do
  if [[ -r "$(mae_proc)/$pid/stat" ]]; then
    visible=true
    c="$(cli_of_pid "$pid")"
    if [[ -n "$c" ]]; then
      seen[$c]=1
      if [[ -z "$host" ]]; then host="$c"; host_pid="$pid"; ev "ancestor $pid is $c"; fi
    fi
  fi
  pid="$(mae_pid_ppid "$pid")"
  hops=$((hops + 1))
done

hidden=()
for c in codex cursor agy claude-code; do
  if marker_present "$c" && [[ -z "${seen[$c]:-}" ]]; then hidden+=("$c"); fi
done
if [[ -n "$host" && ${#hidden[@]} -gt 0 ]]; then
  ev "marker of ${hidden[*]} present but not in the visible ancestry: ancestry incomplete"
  host="unknown" host_pid=""
elif [[ -n "$host" && "$host" != "claude-code" ]]; then
  ev "the nearest agent CLI is $host: maestro directs only from Claude Code ($host is a worker)"
  host="unsupported" host_pid=""
elif [[ "$host" == "claude-code" ]]; then
  if marker_present claude-code; then ev "marker CLAUDECODE=1 present"
  else ev "nearest agent CLI is claude without CLAUDECODE=1 in this environment"; host="unknown" host_pid=""; fi
else
  [[ "$visible" == true ]] && ev "no agent CLI in the visible ancestry"
  others=()
  for c in codex cursor agy; do marker_present "$c" && others+=("$c"); done
  if marker_present claude-code && [[ ${#others[@]} -eq 0 ]]; then
    host="claude-code"; ev "markers-only: CLAUDECODE=1 and no other agent CLI's marker"
  elif [[ ${#others[@]} -gt 0 ]]; then
    host="unknown"; ev "markers-only: ${others[*]} marker present, nesting order unknown"
  else
    host="unknown"; ev "no ancestry and no marker"
  fi
fi

interactive=null starttime="" skey="" dfamily=""
if [[ "$host" == "claude-code" ]]; then
  skey="${CLAUDE_CODE_SESSION_ID:-}" dfamily=claude
  if [[ -n "$host_pid" ]]; then
    interactive="$(interactive_of_pid "$host_pid")"
    starttime="$(mae_pid_starttime "$host_pid")"
  fi
fi

jq -cn --arg host "$host" --argjson interactive "$interactive" --arg skey "$skey" \
  --arg hpid "$host_pid" --arg hst "$starttime" --arg fam "$dfamily" --args '{
    host: $host, interactive: $interactive,
    session_key: (if $skey == "" then null else $skey end),
    host_pid: (if $hpid == "" then null else ($hpid | tonumber) end),
    host_pid_starttime: (if $hst == "" then null else $hst end),
    director_family: (if $fam == "" then null else $fam end),
    evidence: $ARGS.positional }' "${evidence[@]}"
