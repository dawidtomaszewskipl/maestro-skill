#!/usr/bin/env bash
# maestro-validate — envelope, verdict extraction and schema check for every CLI
# (docs/commands.md, "Validating a verdict").
#
#   maestro-validate <schema.json> <file> --envelope codex|agy|claude|raw [--role read-only|writer]
#                    [--decide critique|arbiter [--ids <id,id,…>]]
#
# 1. Envelope (envelope failure is not an invalid verdict):
#    codex   the -o file is the answer text
#    agy     {status: "SUCCESS", denied_actions: absent or [], finished_reason: absent} → structured_output if present and not
#            null (agy fills it when --json-schema is given), else response; the chosen text non-empty
#    claude  stream-json/json: the `result` event with subtype "success", is_error false, and for
#            read-only roles permission_denials == [] → structured_output if present, else result
#    raw     the file itself
# 2. Extraction: strip one surrounding Markdown fence; exactly ONE top-level JSON object must
#    parse; leading prose is allowed, trailing non-whitespace is not. toolAction/toolSummary keys
#    (agy before 1.4.0 put them into response) are dropped.
# 3. Schema: type, enum, required, properties, additionalProperties:false, items — recursively.
# 4. With --decide, the mechanical decision (docs/briefs.md, "Plan critique"), added as
#    decision: {approved, reasons}:
#    critique  approved iff verdict approve, blocking_findings and major_findings empty and every
#              prior finding resolved. Invalid (stage "decide"): an approve that still lists a
#              finding or a not_resolved prior finding; a finding with an empty trigger.
#    arbiter   approved iff there is at least one verdict and every verdict is downgraded.
#    --ids     the ids the director sent — prior findings (critique; "" in round 1) or disputed
#              findings (arbiter). A missing or unknown id is invalid; an id listed twice always is.
# Prints {valid, stage, errors, verdict}; exit 0 iff valid (a valid revise exits 0, approved false).
set -euo pipefail
. "$(dirname "$(readlink -f "$0")")/_lib.sh"

schema="${1:-}" file="${2:-}"; shift 2 || true
envelope="raw" role="read-only" decide="" ids="" has_ids=false
while [[ $# -gt 0 ]]; do
  case "$1" in
    --envelope) envelope="$2"; shift 2 ;;
    --role) role="$2"; shift 2 ;;
    --decide) [[ $# -ge 2 ]] || mae_die "maestro-validate: --decide needs critique|arbiter"
              decide="$2"; shift 2 ;;
    --ids) [[ $# -ge 2 ]] || mae_die "maestro-validate: --ids needs a list (may be empty)"
           ids="$2" has_ids=true; shift 2 ;;
    *) mae_die "maestro-validate: unknown option $1" ;;
  esac
done
[[ -f "$schema" && -f "$file" ]] || mae_die "usage: maestro-validate <schema.json> <file> --envelope … [--role …] [--decide critique|arbiter [--ids …]]"
[[ -z "$decide" || "$decide" == critique || "$decide" == arbiter ]] || mae_die "maestro-validate: unknown --decide $decide"
[[ "$has_ids" == false || -n "$decide" ]] || mae_die "maestro-validate: --ids needs --decide"

# Every output passes through here: with --decide an invalid answer is never approved.
emit() {  # emit <json> [<decision json>]
  if [[ -z "$decide" ]]; then printf '%s\n' "$1"
  elif [[ -n "${2:-}" ]]; then jq -c --argjson d "$2" '. + {decision: $d}' <<<"$1"
  else jq -c '. + {decision: {approved: false, reasons: (["invalid (\(.stage))"] + .errors)}}' <<<"$1"; fi
}
fail() { emit "$(jq -cn --arg st "$1" --arg e "$2" '{valid: false, stage: $st, errors: [$e], verdict: null}')"; exit 1; }

# --- 1. envelope ------------------------------------------------------------------------------
last_result() { mae_result_event "$file"; }  # the last `result` event of a json or stream-json transcript
case "$envelope" in
  raw|codex) text="$(cat "$file")" ;;
  agy)
    jq -e . "$file" >/dev/null 2>&1 || fail envelope "agy envelope is not JSON"
    [[ "$(jq -r .status "$file")" == SUCCESS ]] || fail envelope "agy status $(jq -r .status "$file")"
    [[ "$(jq '(.denied_actions // []) | length' "$file")" == 0 ]] || fail envelope "agy denied_actions: $(jq -c .denied_actions "$file")"
    fr="$(jq -r '.finished_reason // empty' "$file")"   # agy >= 1.4.11: print_timeout, interrupted, error
    [[ -z "$fr" ]] || fail envelope "agy finished_reason $fr"
    if [[ "$(jq 'has("structured_output") and .structured_output != null' "$file")" == true ]]; then
      text="$(jq -c .structured_output "$file")"
    else
      text="$(jq -r '.response // ""' "$file")"
    fi
    [[ -n "$text" ]] || fail envelope "agy response is empty" ;;
  claude)
    res="$(last_result)"
    [[ -n "$res" ]] || fail envelope "no result event"
    [[ "$(jq -r .subtype <<<"$res")" == success && "$(jq -r .is_error <<<"$res")" == false ]] \
      || fail envelope "result: subtype $(jq -r .subtype <<<"$res"), is_error $(jq -r .is_error <<<"$res")"
    if [[ "$role" == read-only ]]; then
      [[ "$(jq '(.permission_denials // []) | length' <<<"$res")" == 0 ]] \
        || fail envelope "permission_denials on a read-only role: $(jq -c '[.permission_denials[].tool_name]' <<<"$res")"
    fi
    if [[ "$(jq 'has("structured_output") and .structured_output != null' <<<"$res")" == true ]]; then
      text="$(jq -c .structured_output <<<"$res")"
    else
      text="$(jq -r '.result // ""' <<<"$res")"
    fi ;;
  *) mae_die "maestro-validate: unknown envelope $envelope" ;;
esac

# --- 2. extraction: one top-level object --------------------------------------------------------
# shellcheck disable=SC2016  # jq program
extract='
  # strip one surrounding fence
  (if test("^\\s*```[a-zA-Z]*\\s*\\n") and test("\\n\\s*```\\s*$")
   then sub("^\\s*```[a-zA-Z]*\\s*\\n"; "") | sub("\\n\\s*```\\s*$"; "") else . end) as $t
  | ($t | explode) as $c
  # scan for top-level {...} spans, honouring strings and escapes
  | reduce range(0; $c | length) as $i ({depth: 0, instr: false, esc: false, start: null, spans: []};
      ($c[$i]) as $ch
      | if .instr then
          if .esc then .esc = false
          elif $ch == 92 then .esc = true
          elif $ch == 34 then .instr = false
          else . end
        elif $ch == 34 then (if .depth > 0 then .instr = true else . end)
        elif $ch == 123 then (if .depth == 0 then .start = $i else . end) | .depth += 1
        elif $ch == 125 then
          if .depth > 0 then .depth -= 1
            | if .depth == 0 then .spans += [[.start, $i]] | .start = null else . end
          else . end
        else . end)
  | .spans as $spans
  | [ $spans[] as [$a, $b] | ($c[$a:$b + 1] | implode) as $s
      | ($s | try fromjson catch null) as $o
      | select($o != null and ($o | type) == "object") | {o: $o, end: $b} ] as $objs
  | if ($objs | length) == 0 then {error: "no JSON object found"}
    elif ($objs | length) > 1 then {error: "more than one top-level JSON object"}
    else ($c[$objs[0].end + 1:] | implode | test("^\\s*$")) as $clean
      | if $clean then {ok: ($objs[0].o | del(.toolAction, .toolSummary))}
        else {error: "text after the JSON object"} end
    end'
ext="$(jq -Rs "$extract" <<<"$text")" || fail extract "extraction failed"
if [[ "$(jq 'has("error")' <<<"$ext")" == true ]]; then fail extract "$(jq -r .error <<<"$ext")"; fi
verdict="$(jq -c .ok <<<"$ext")"

# --- 3. schema ----------------------------------------------------------------------------------
# shellcheck disable=SC2016  # jq program
check='
  def typeok($t): (type) as $x
    | if $t == "integer" then ($x == "number" and (. == floor))
      elif $t == "number" then $x == "number"
      elif $t == "array" then $x == "array"
      elif $t == "object" then $x == "object"
      elif $t == "string" then $x == "string"
      elif $t == "boolean" then $x == "boolean"
      elif $t == "null" then $x == "null" else true end;
  def errs($s; $p):
    . as $v
    | [ (if $s.type and (($s.type | type) == "string") and ($v | typeok($s.type) | not)
         then "\($p): expected \($s.type), got \($v | type)" else empty end),
        (if $s.enum and (($s.enum | index([$v])) == null) then "\($p): \($v | tojson) not in enum" else empty end),
        (if ($v | type) == "object" then
           ( ($s.required // [])[] as $r | if ($v | has($r)) then empty else "\($p): missing required \($r)" end ),
           ( if $s.additionalProperties == false then
               ($v | keys[]) as $k | if (($s.properties // {}) | has($k)) then empty else "\($p): unexpected key \($k)" end
             else empty end ),
           ( ($s.properties // {}) | to_entries[] as $e
             | if ($v | has($e.key)) then ($v[$e.key] | errs($e.value; "\($p).\($e.key)"))[] else empty end )
         else empty end),
        (if ($v | type) == "array" and $s.items then
           ($v | to_entries[] | .key as $i | .value | errs($s.items; "\($p)[\($i)]"))[]
         else empty end) ];
  errs($schema[0]; "$")'
errors="$(jq -c --slurpfile schema "$schema" "$check" <<<"$verdict")"
if [[ "$errors" != "[]" ]]; then
  emit "$(jq -cn --argjson e "$errors" --argjson v "$verdict" '{valid: false, stage: "schema", errors: $e, verdict: $v}')"
  exit 1
fi
if [[ -z "$decide" ]]; then
  jq -cn --argjson v "$verdict" '{valid: true, stage: "schema", errors: [], verdict: $v}'
  exit 0
fi

# --- 4. decision --------------------------------------------------------------------------------
# errors: the answer contradicts itself or the ids sent (invalid); reasons: why it does not approve.
# A schema that is not the one --decide names fails here, not in jq.
# shellcheck disable=SC2016  # jq program
decision='
  def plural($n; $w): "\($n) \($w) finding\(if $n == 1 then "" else "s" end)";
  ($ids | split(",") | map(gsub("^\\s+|\\s+$"; "")) | map(select(. != ""))) as $want
  | (if $kind == "critique" then .prior_findings else .verdicts end | map(.id)) as $got
  | ( [ $got | group_by(.)[] | select(length > 1) | "id \(.[0]) listed twice" ]
      + (if $has_ids then
           [ $want[] | . as $i | select(($got | index($i)) == null) | "id \($i) sent but not answered" ]
           + [ $got | unique[] | . as $i | select(($want | index($i)) == null) | "id \($i) was not sent" ]
         else [] end) ) as $iderrs
  | if $kind == "critique" then
      (.blocking_findings | length) as $b | (.major_findings | length) as $m
      | [ .prior_findings[] | select(.status == "not_resolved") | .id ] as $open
      | ( [ ("blocking_findings", "major_findings") as $k | .[$k] | to_entries[]
            | select(.value.trigger | test("^\\s*$")) | "$.\($k)[\(.key)].trigger: empty" ]
          + (if .verdict == "approve" and ($b + $m) > 0
             then ["approve with \(plural($b; "blocking")) and \(plural($m; "major")) listed"] else [] end)
          + (if .verdict == "approve" and ($open | length) > 0
             then ["approve with prior finding \($open | join(", ")) not resolved"] else [] end) ) as $errs
      | {errors: ($iderrs + $errs),
         reasons: ( (if .verdict != "approve" then ["verdict \(.verdict)"] else [] end)
                    + (if $b > 0 then [plural($b; "blocking")] else [] end)
                    + (if $m > 0 then [plural($m; "major")] else [] end)
                    + [ $open[] | "prior finding \(.) not resolved" ] )}
    else
      {errors: $iderrs,
       reasons: ( (if (.verdicts | length) == 0 then ["no verdicts"] else [] end)
                  + [ .verdicts[] | select(.decision == "upheld") | "\(.id) upheld" ] )}
    end'
dec="$(jq -c --arg kind "$decide" --arg ids "$ids" --argjson has_ids "$has_ids" "$decision" <<<"$verdict" 2>/dev/null)" \
  || fail decide "the verdict does not have the shape --decide $decide reads (wrong schema?)"
if [[ "$(jq -c .errors <<<"$dec")" != "[]" ]]; then
  emit "$(jq -cn --argjson d "$dec" --argjson v "$verdict" '{valid: false, stage: "decide", errors: $d.errors, verdict: $v}')"
  exit 1
fi
emit "$(jq -cn --argjson v "$verdict" '{valid: true, stage: "schema", errors: [], verdict: $v}')" \
     "$(jq -c '{approved: (.reasons | length == 0), reasons: .reasons}' <<<"$dec")"
